{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vitest": {
    "config": [
      "vitest.config.ts"
    ],
    "entry": [
      "**/*.{test,bench}.?(c|m)[jt]s?(x)",
      "**/__tests__/**/*.?(c|m)[jt]s?(x)"
    ]
  },
  "ignoreDependencies": [
    "tsx",
    "concurrently",
    "@inlang/paraglide-js",
    "@vitejs/plugin-react",
    "@tailwindcss/vite",
    "esbuild",
    "yaml",
    "onnxruntime-node"
  ],
  "ignoreBinaries": [
    "cmake",
    "ctest",
    "ffmpeg",
    "tilt",
    "where.exe",
    "osascript"
  ],
  "ignore": [
    "scripts/dev-hosts.d.mts"
  ],
  "ignoreWorkspaces": [
    "commons/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/**/*.mjs",
        "demos/**/jsdsp.ts"
      ]
    },
    "engine/moteur": {
      "entry": [
        "scripts/*.{ts,mjs}"
      ]
    },
    "apps/studio-desktop": {
      "entry": [
        "src/main.ts",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "electron-builder"
      ]
    },
    "apps/st0/frontend": {
      "entry": [
        "src/docs/examples.ts"
      ]
    },
    "apps/k7/backend": {
      "ignoreDependencies": [
        "@types/multer"
      ]
    },
    "apps/z0/backend": {
      "entry": [
        "src/render.ts"
      ]
    },
    "packages/song": {
      "entry": [
        "src/dspRunner.mjs",
        "src/benchProject.ts",
        "scripts/*.ts"
      ]
    },
    "packages/song-edit": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "packages/audio-probe": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "packages/song-schema": {
      "entry": [
        "src/builtinParams.generated.ts"
      ]
    },
    "packages/dsp": {
      "entry": [
        "modules/**/jsdsp.ts"
      ]
    },
    "packages/file-service": {
      "entry": [
        "src/render.ts"
      ]
    },
    "packages/stem-separation": {
      "entry": [
        "src/separateWorker.ts"
      ]
    },
    "packages/engine-host": {
      "entry": [
        "src/engineQueries.ts"
      ]
    },
    "packages/take-render": {
      "entry": [
        "src/timeline.ts"
      ]
    },
    "packages/ui-turntables": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "packages/ui-chains-react": {}
  }
}
