{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": [
      "**/*.{test,bench}.?(c|m)[jt]s?(x)",
      "**/__tests__/**/*.?(c|m)[jt]s?(x)"
    ]
  },
  "ignoreDependencies": [
    "tsx",
    "@vitejs/plugin-react",
    "@tailwindcss/vite",
    "esbuild"
  ],
  "ignoreBinaries": [
    "cmake",
    "ctest",
    "ffmpeg",
    "tilt",
    "where.exe"
  ],
  "ignore": ["scripts/dev-hosts.d.mts", "engine/**/build/**"],
  "ignoreWorkspaces": ["commons/**"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["node-pty", "@xterm/xterm", "@xterm/addon-fit"],
      "entry": [
        "scripts/*.mjs",
        "scripts/**/*.mjs",
        "demos/**/jsdsp.ts",
        "demos/_modules/**/widgets.js",
        "k7-core/modules/**/{jsdsp.ts,widgets.js}",
        "engine/k7-android/scripts/termux-tools.mjs",
        "engine/k7-android/app/src/main/assets/*.js"
      ]
    },
    "engine/k7-runtime": {
      "entry": ["scripts/*.{ts,mjs}", "engine/strudel/strudel.bundle.js"]
    },
    "apps/k7/frontend": {
      "entry": ["src/docs/examples.ts"]
    },
    "apps/k7/backend": {
      "entry": ["scripts/bundle.mjs"]
    },
    "apps/k7-standalone": {
      "entry": ["electron-builder.cjs", "src/main.ts", "src/preload.ts"],
      "ignoreBinaries": ["vite"]
    },
    "engine/k7-android/web": {
      "ignoreDependencies": ["@capacitor/android"]
    },
    "packages/rehearsal-server": {
      "ignoreDependencies": ["@types/multer"]
    },
    "packages/song": {
      "entry": ["src/benchProject.ts", "scripts/*.ts"]
    },
    "packages/audio-probe": {
      "entry": ["scripts/*.ts"]
    },
    "packages/song-schema": {
      "entry": ["src/builtinParams.generated.ts"]
    },
    "packages/file-service": {
      "entry": ["src/render.ts"]
    },
    "packages/take-render": {
      "entry": ["src/timeline.ts"]
    },
    "packages/k7-plugins": {
      "entry": ["scripts/turntables/*.ts"]
    },
    "packages/ui-chains-react": {}
  }
}
