// Assourdissant — Music sounds better with you — les effets de la question, en chaîne. Le sidecar du morceau la nomme comme
// variante ; l'ordre des modules et la correspondance des valeurs sont dans
// apps/z0/docs/effects.md du dépôt studio.

steps([
  id("f60e20d8-1fb2-442c-9dde-3fda0a29d742")
    .extends("@k7-core/audio/overdrive")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 5 } } }),
  to([chain("@out")]),
])
