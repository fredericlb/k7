// Déformées — Call me maybe — les effets de la question, en chaîne. Le sidecar du morceau la nomme comme
// variante ; l'ordre des modules et la correspondance des valeurs sont dans
// apps/z0/docs/effects.md du dépôt studio.

steps([
  id("1a0caaeb-9da2-4886-9e73-9d856b6c5a09")
    .extends("@k7-core/audio/zz_utility/pitch-shift")
    .params({ "semitones up": -12 }),
  id("4ca6ae6e-110b-43c8-947f-470b07fb7124")
    .extends("@k7-core/audio/lowpass")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 18 } } }),
  id("84e0511b-7f35-4456-947d-27b875d93656")
    .extends("@k7-core/audio/phaser")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 28 } } }),
  id("88868544-89ed-4126-a14e-cc3fad5f2857")
    .extends("@k7-core/audio/overdrive")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 5 } } }),
  to([chain("@out")]),
])
