// Déformées — Boys don't cry — les effets de la question, en chaîne. Le sidecar du morceau la nomme comme
// variante.

steps([
  id("25ba2b1f-b6c6-4283-af27-73a86967d5d9")
    .extends("@k7-core/audio/vibrato")
    .engine("wobble")
    .engines({ wobble: { params: { Amount: 41 } } }),
  id("a82ced32-f861-4f31-8cdf-68abc11dc36a")
    .extends("@k7-core/audio/phaser")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 58 } } }),
  to([chain("@out")]),
])
