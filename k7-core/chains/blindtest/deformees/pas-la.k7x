// Déformées — Pas la — les effets de la question, en chaîne. Le sidecar du morceau la nomme comme
// variante.

steps([
  id("30d2e47a-0060-4355-9b84-ca1b2d54fee8")
    .extends("@k7-core/audio/zz_utility/pitch-shift")
    .params({ "semitones up": -8 }),
  id("70d4e7b0-6c4b-447d-9d4b-99b86c87c60e")
    .extends("@k7-core/audio/bitcrush")
    .engine("de-rez")
    .engines({ de-rez: { params: { Rez: 0.193, Rate: 1 } } }),
  id("ddaa5935-6c7c-4ce1-b2a5-b8feb151d544")
    .extends("@k7-core/audio/lowpass")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 62 } } }),
  id("ed34e7f0-01f7-483a-b24d-a5e6c80fea13")
    .extends("@k7-core/audio/highpass")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 42 } } }),
  id("93811f47-f35f-4701-91f0-2bc435bb45ac")
    .extends("@k7-core/audio/overdrive")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 4 } } }),
  to([chain("@out")]),
])
