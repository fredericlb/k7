// The deck's tempo. COLD and offline: a tempo change is a time stretch, a stretch has to know
// where the file ends, and no engine plugin stretches time — packages/song/docs/coldModules.md.
extends("@k7-core/cold/tempo")
params({
  // Measured by the pass that reads the file.
  "Source BPM": 0,
  // What the tempo fader sets; 0 means "leave it alone".
  "Target BPM": 0,
})
