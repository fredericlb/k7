// The four knobs of a grade, each neutral at its middle.
cols(4)
rows(1)
widgets({
  exposure: { type: "knob", col: 0, row: 0, bind: "P1", min: 0, max: 1, step: 0.01 },
  contrast: { type: "knob", col: 1, row: 0, bind: "P2", min: 0, max: 1, step: 0.01 },
  saturation: { type: "knob", col: 2, row: 0, bind: "P3", min: 0, max: 1, step: 0.01 },
  temperature: { type: "knob", col: 3, row: 0, bind: "P4", min: 0, max: 1, step: 0.01 },
})
