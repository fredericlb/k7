// parametric — a five-band EQ: its curve on an interactive screen, each band's gain fader beside its frequency and Q
cols(16)
rows(4)
widgets({
  eq: { type: "lcdscreen", col: 0, row: 0, colSpan: 6, rowSpan: 4 },
  low_band: { type: "group", col: 6, row: 0, colSpan: 2, rowSpan: 4, label: "LOW", color: "#ff6a1a26" },
  low_gain: { type: "fader", col: 6, row: 0, rowSpan: 4, label: "Gain", bind: "Low Gain", min: -18, max: 18, step: 0.1 },
  low_freq: { type: "knob", col: 7, row: 0, label: "Freq", bind: "Low Freq", min: 20, max: 1000 },
  low_q: { type: "knob", col: 7, row: 1, label: "Q", bind: "Low Q", min: 0.3, max: 2 },
  lowmid_band: { type: "group", col: 8, row: 0, colSpan: 2, rowSpan: 4, label: "LO MID", color: "#ffc93d26" },
  lowmid_gain: { type: "fader", col: 8, row: 0, rowSpan: 4, label: "Gain", bind: "Low Mid Gain", min: -18, max: 18, step: 0.1 },
  lowmid_freq: { type: "knob", col: 9, row: 0, label: "Freq", bind: "Low Mid Freq", min: 40, max: 4000 },
  lowmid_q: { type: "knob", col: 9, row: 1, label: "Q", bind: "Low Mid Q", min: 0.1, max: 10 },
  mid_band: { type: "group", col: 10, row: 0, colSpan: 2, rowSpan: 4, label: "MID", color: "#3ec96b26" },
  mid_gain: { type: "fader", col: 10, row: 0, rowSpan: 4, label: "Gain", bind: "Mid Gain", min: -18, max: 18, step: 0.1 },
  mid_freq: { type: "knob", col: 11, row: 0, label: "Freq", bind: "Mid Freq", min: 200, max: 8000 },
  mid_q: { type: "knob", col: 11, row: 1, label: "Q", bind: "Mid Q", min: 0.1, max: 10 },
  highmid_band: { type: "group", col: 12, row: 0, colSpan: 2, rowSpan: 4, label: "HI MID", color: "#3d7dff26" },
  highmid_gain: { type: "fader", col: 12, row: 0, rowSpan: 4, label: "Gain", bind: "High Mid Gain", min: -18, max: 18, step: 0.1 },
  highmid_freq: { type: "knob", col: 13, row: 0, label: "Freq", bind: "High Mid Freq", min: 800, max: 16000 },
  highmid_q: { type: "knob", col: 13, row: 1, label: "Q", bind: "High Mid Q", min: 0.1, max: 10 },
  high_band: { type: "group", col: 14, row: 0, colSpan: 2, rowSpan: 4, label: "HIGH", color: "#b35cff26" },
  high_gain: { type: "fader", col: 14, row: 0, rowSpan: 4, label: "Gain", bind: "High Gain", min: -18, max: 18, step: 0.1 },
  high_freq: { type: "knob", col: 15, row: 0, label: "Freq", bind: "High Freq", min: 1000, max: 20000 },
  high_q: { type: "knob", col: 15, row: 1, label: "Q", bind: "High Q", min: 0.3, max: 2 },
})
vertical({
  cols: 4,
  rows: 15,
  widgets: {
    eq: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 3 },
    low_band: { type: "group", col: 0, row: 3, colSpan: 2, rowSpan: 4, label: "LOW", color: "#ff6a1a26" },
    low_gain: { type: "fader", col: 0, row: 3, rowSpan: 4, label: "Gain", bind: "Low Gain", min: -18, max: 18, step: 0.1 },
    low_freq: { type: "knob", col: 1, row: 3, label: "Freq", bind: "Low Freq", min: 20, max: 1000 },
    low_q: { type: "knob", col: 1, row: 4, label: "Q", bind: "Low Q", min: 0.3, max: 2 },
    lowmid_band: { type: "group", col: 2, row: 3, colSpan: 2, rowSpan: 4, label: "LO MID", color: "#ffc93d26" },
    lowmid_gain: { type: "fader", col: 2, row: 3, rowSpan: 4, label: "Gain", bind: "Low Mid Gain", min: -18, max: 18, step: 0.1 },
    lowmid_freq: { type: "knob", col: 3, row: 3, label: "Freq", bind: "Low Mid Freq", min: 40, max: 4000 },
    lowmid_q: { type: "knob", col: 3, row: 4, label: "Q", bind: "Low Mid Q", min: 0.1, max: 10 },
    mid_band: { type: "group", col: 0, row: 7, colSpan: 2, rowSpan: 4, label: "MID", color: "#3ec96b26" },
    mid_gain: { type: "fader", col: 0, row: 7, rowSpan: 4, label: "Gain", bind: "Mid Gain", min: -18, max: 18, step: 0.1 },
    mid_freq: { type: "knob", col: 1, row: 7, label: "Freq", bind: "Mid Freq", min: 200, max: 8000 },
    mid_q: { type: "knob", col: 1, row: 8, label: "Q", bind: "Mid Q", min: 0.1, max: 10 },
    highmid_band: { type: "group", col: 2, row: 7, colSpan: 2, rowSpan: 4, label: "HI MID", color: "#3d7dff26" },
    highmid_gain: { type: "fader", col: 2, row: 7, rowSpan: 4, label: "Gain", bind: "High Mid Gain", min: -18, max: 18, step: 0.1 },
    highmid_freq: { type: "knob", col: 3, row: 7, label: "Freq", bind: "High Mid Freq", min: 800, max: 16000 },
    highmid_q: { type: "knob", col: 3, row: 8, label: "Q", bind: "High Mid Q", min: 0.1, max: 10 },
    high_band: { type: "group", col: 0, row: 11, colSpan: 2, rowSpan: 4, label: "HIGH", color: "#b35cff26" },
    high_gain: { type: "fader", col: 0, row: 11, rowSpan: 4, label: "Gain", bind: "High Gain", min: -18, max: 18, step: 0.1 },
    high_freq: { type: "knob", col: 1, row: 11, label: "Freq", bind: "High Freq", min: 1000, max: 20000 },
    high_q: { type: "knob", col: 1, row: 12, label: "Q", bind: "High Q", min: 0.3, max: 2 },
  },
})
