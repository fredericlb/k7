// soft-gate — a gentle gate that darkens as it closes
cols(6)
rows(2)
widgets({
  thresh: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Thresh", bind: "Thresh", min: 0, max: 1 },
  darken: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Darken", bind: "Darken", min: 0, max: 1 },
  silence: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Silence", bind: "Silence", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    thresh: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Thresh", bind: "Thresh", min: 0, max: 1 },
    darken: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Darken", bind: "Darken", min: 0, max: 1 },
    silence: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Silence", bind: "Silence", min: 0, max: 1 },
  },
})
