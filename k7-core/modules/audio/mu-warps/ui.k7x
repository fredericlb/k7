// mu-warps — Mutable Warps, a meta-modulator crossing a carrier with the input
cols(8)
rows(3)
widgets({
  algo_section: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "ALGO", color: "#3d7dff26" },
  algorithm: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Algo", bind: "Algorithm", min: 0, max: 1 },
  timbre: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Timbre", bind: "Timbre", min: 0, max: 1 },
  level_section: { type: "group", col: 4, row: 0, colSpan: 4, rowSpan: 2, label: "LVL", color: "#ff6a1a26" },
  carrier_level: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Car", bind: "Carrier level", min: 0, max: 1 },
  modulator_level: { type: "knob", col: 6, row: 0, colSpan: 2, rowSpan: 2, label: "Mod", bind: "Modulator level", min: 0, max: 1 },
  osc_section: { type: "group", col: 0, row: 2, colSpan: 8, label: "OSC", color: "#3ec96b26" },
  carrier: { type: "dropdown", col: 0, row: 2, colSpan: 6, label: "Carrier", bind: "Carrier", options: [label("sidechain").value(0), label("sine").value(1), label("triangle").value(2), label("saw").value(3)] },
  transpose: { type: "number", col: 6, row: 2, colSpan: 2, label: "Transp", bind: "Transpose", min: -24, max: 24, step: 1 },
})
vertical({
  cols: 4,
  rows: 6,
  widgets: {
    algo_section: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "ALGO", color: "#3d7dff26" },
    algorithm: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Algo", bind: "Algorithm", min: 0, max: 1 },
    timbre: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Timbre", bind: "Timbre", min: 0, max: 1 },
    level_section: { type: "group", col: 0, row: 2, colSpan: 4, rowSpan: 2, label: "LVL", color: "#ff6a1a26" },
    carrier_level: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Car", bind: "Carrier level", min: 0, max: 1 },
    modulator_level: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Mod", bind: "Modulator level", min: 0, max: 1 },
    osc_section: { type: "group", col: 0, row: 4, colSpan: 4, rowSpan: 2, label: "OSC", color: "#3ec96b26" },
    carrier: { type: "dropdown", col: 0, row: 4, colSpan: 4, label: "Carrier", bind: "Carrier", options: [label("sidechain").value(0), label("sine").value(1), label("triangle").value(2), label("saw").value(3)] },
    transpose: { type: "number", col: 0, row: 5, colSpan: 2, label: "Transp", bind: "Transpose", min: -24, max: 24, step: 1 },
  },
})
