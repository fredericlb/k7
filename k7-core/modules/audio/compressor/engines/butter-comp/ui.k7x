// butter-comp — a smooth bi-polar compressor
cols(6)
rows(2)
widgets({
  levels: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 2 },
  compress: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Comp", bind: "Compress", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    levels: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 2 },
    compress: { type: "knob", col: 1, row: 2, colSpan: 2, rowSpan: 2, label: "Comp", bind: "Compress", min: 0, max: 1 },
  },
})
