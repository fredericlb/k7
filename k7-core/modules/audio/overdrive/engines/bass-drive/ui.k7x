// bass-drive — AirWindows' bass amp drive, with its four-band voicing
cols(10)
rows(3)
widgets({
  drive: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 3, label: "Drive", bind: "Drive", min: 0, max: 1 },
  eq_section: { type: "group", col: 2, row: 0, colSpan: 4, rowSpan: 3, label: "EQ", color: "#3ec96b26" },
  low: { type: "fader", col: 2, row: 0, rowSpan: 3, label: "Low", bind: "Low", min: 0, max: 1 },
  mid: { type: "fader", col: 3, row: 0, rowSpan: 3, label: "Mid", bind: "Mid", min: 0, max: 1 },
  high: { type: "fader", col: 4, row: 0, rowSpan: 3, label: "High", bind: "High", min: 0, max: 1 },
  presence: { type: "fader", col: 5, row: 0, rowSpan: 3, label: "Pres", bind: "Presnce", min: 0, max: 1 },
  shape: { type: "lcdscreen", col: 6, row: 0, colSpan: 4, rowSpan: 3 },
})
vertical({
  cols: 4,
  rows: 7,
  widgets: {
    drive: { type: "knob", col: 1, row: 0, colSpan: 2, rowSpan: 2, label: "Drive", bind: "Drive", min: 0, max: 1 },
    eq_section: { type: "group", col: 0, row: 2, colSpan: 4, rowSpan: 3, label: "EQ", color: "#3ec96b26" },
    low: { type: "fader", col: 0, row: 2, rowSpan: 3, label: "Low", bind: "Low", min: 0, max: 1 },
    mid: { type: "fader", col: 1, row: 2, rowSpan: 3, label: "Mid", bind: "Mid", min: 0, max: 1 },
    high: { type: "fader", col: 2, row: 2, rowSpan: 3, label: "High", bind: "High", min: 0, max: 1 },
    presence: { type: "fader", col: 3, row: 2, rowSpan: 3, label: "Pres", bind: "Presnce", min: 0, max: 1 },
    shape: { type: "lcdscreen", col: 0, row: 5, colSpan: 4, rowSpan: 2 },
  },
})
