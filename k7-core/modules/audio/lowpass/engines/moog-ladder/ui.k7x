// moogladder — Moog Ladder, the four-pole resonant low pass
cols(10)
rows(2)
widgets({
  cutoff: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Cutoff", bind: "Cutoff", min: 20, max: 20000, curve: "log" },
  res: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Res", bind: "Res", min: 0, max: 0.95 },
  response: { type: "lcdscreen", col: 4, row: 0, colSpan: 6, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    cutoff: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Cutoff", bind: "Cutoff", min: 20, max: 20000, curve: "log" },
    res: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Res", bind: "Res", min: 0, max: 0.95 },
    response: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 2 },
  },
})
