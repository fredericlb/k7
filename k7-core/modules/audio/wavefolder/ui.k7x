// fracture — a wavefolding distortion
cols(8)
rows(3)
widgets({
  section: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "FOLD", color: "#ff6a1a26" },
  drive: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Drive", bind: "Drive", min: 0, max: 1 },
  fracture: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Fracture", bind: "Fracture", min: 0, max: 1 },
  io: { type: "lcdscreen", col: 4, row: 0, colSpan: 4, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    section: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "FOLD", color: "#ff6a1a26" },
    drive: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Drive", bind: "Drive", min: 0, max: 1 },
    fracture: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Fracture", bind: "Fracture", min: 0, max: 1 },
    io: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 2 },
  },
})
