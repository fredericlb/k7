// fathom-five — a bass enhancer that adds a sub octave under a chosen root
cols(6)
rows(2)
widgets({
  root_note: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Root", bind: "Root Note", min: 0, max: 1 },
  sub_octave: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "SubOct", bind: "SubOctave", min: 0, max: 1 },
  frequency: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Freq", bind: "Frequency", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    root_note: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Root", bind: "Root Note", min: 0, max: 1 },
    sub_octave: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "SubOct", bind: "SubOctave", min: 0, max: 1 },
    frequency: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Freq", bind: "Frequency", min: 0, max: 1 },
  },
})
