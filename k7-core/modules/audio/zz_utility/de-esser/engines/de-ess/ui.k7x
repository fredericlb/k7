// de-ess — Airwindows DeEss, a de-esser
cols(6)
rows(2)
widgets({
  intense: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Intense", bind: "Intense", min: 0, max: 1 },
  max_ds: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Max DS", bind: "Max DS", min: 0, max: 1 },
  freq: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Freq", bind: "Freq", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    intense: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Intense", bind: "Intense", min: 0, max: 1 },
    max_ds: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Max DS", bind: "Max DS", min: 0, max: 1 },
    freq: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Freq", bind: "Freq", min: 0, max: 1 },
  },
})
