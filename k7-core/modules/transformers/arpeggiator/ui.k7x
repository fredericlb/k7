// panel for @k7-core/transformers/arpeggiator
//
// Three lists over a step grid. The lists are CHOICES rather than knobs: a rate has nothing between
// 1/8 and 1/8T. The grid (widgets.js) pictures the selected direction and is where a pattern is
// drawn, with a velocity bar and a gate bar under each step; editing a preset switches `Sens` to
// Custom, starting from what the grid was showing.
//
// The values are the plugin's (engine/k7-runtime/engine/ArpeggiatorPlugin.cpp): the division index
// for `Rate`, the octave count for `Octaves`, 0..4 for `Direction`, and `Steps` / `Step n` /
// `Velocity n` / `Gate n` for Custom.
cols(8)
rows(4)
widgets({
  rate: { type: "dropdown", col: 0, row: 0, colSpan: 2, label: "Cadence", bind: "Rate", options: [label("1/1").value(0), label("1/2").value(1), label("1/4").value(2), label("1/4T").value(3), label("1/8").value(4), label("1/8T").value(5), label("1/16").value(6), label("1/32").value(7)] },
  octaves: { type: "dropdown", col: 0, row: 1, colSpan: 2, label: "Octaves", bind: "Octaves", options: [label("1").value(1), label("2").value(2), label("3").value(3), label("4").value(4)] },
  direction: { type: "dropdown", col: 0, row: 2, colSpan: 2, label: "Sens", bind: "Direction", options: [label("Montante").value(0), label("Descendante").value(1), label("Aller-retour").value(2), label("Aléatoire").value(3), label("Custom").value(4)] },
  pattern: { type: "lcdscreen", col: 2, row: 0, colSpan: 6, rowSpan: 4 },
})
vertical({
  cols: 4,
  rows: 6,
  widgets: {
    rate: { type: "dropdown", col: 0, row: 0, colSpan: 2, label: "Cadence", bind: "Rate", options: [label("1/1").value(0), label("1/2").value(1), label("1/4").value(2), label("1/4T").value(3), label("1/8").value(4), label("1/8T").value(5), label("1/16").value(6), label("1/32").value(7)] },
    octaves: { type: "dropdown", col: 2, row: 0, colSpan: 2, label: "Octaves", bind: "Octaves", options: [label("1").value(1), label("2").value(2), label("3").value(3), label("4").value(4)] },
    direction: { type: "dropdown", col: 0, row: 1, colSpan: 4, label: "Sens", bind: "Direction", options: [label("Montante").value(0), label("Descendante").value(1), label("Aller-retour").value(2), label("Aléatoire").value(3), label("Custom").value(4)] },
    pattern: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 4 },
  },
})
