// panel for the electric-keys module's clavinet engine
//
// One knob: the instrument's level — the rest of its sound is in its samples. The credit line names its author.
cols(4)
rows(2)
widgets({
  volume: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Volume", bind: "Volume", min: -40, max: 12 },
  credit: { type: "label", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Lithalean · musical-artifacts.com" },
})
