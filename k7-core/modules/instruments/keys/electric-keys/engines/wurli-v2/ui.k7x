      eq_16k: { type: "fader", col: 9, row: 0, rowSpan: 4, label: "16k", bind: "16 kHz high shelf gain", min: 0, max: 1 },
      eq_curve: { type: "lcdscreen", col: 10, row: 0, colSpan: 6, rowSpan: 4 },
    }),
  name("Amp")
    .widgets({
