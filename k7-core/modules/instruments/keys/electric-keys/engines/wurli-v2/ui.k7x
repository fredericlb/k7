// panel for the electric-keys module's wurli-v2 engine
cols(16)
rows(4)
widgets({})
tabs([
  name("Keys")
    .widgets({
      reed: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 4 },
      hammer: { type: "group", col: 4, row: 0, colSpan: 6, rowSpan: 2, label: "HAMMER", color: "#3d7dff26" },
      hardness: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Hard", bind: "Hammer Hardness", min: 0, max: 1 },
      dynamics: { type: "knob", col: 6, row: 0, colSpan: 2, rowSpan: 2, label: "Dynamic", bind: "Dynamics", min: 0, max: 1 },
      damping: { type: "knob", col: 8, row: 0, colSpan: 2, rowSpan: 2, label: "Damp", bind: "Damping Duration", min: 0, max: 1 },
      pickup: { type: "group", col: 4, row: 2, colSpan: 6, rowSpan: 2, label: "PICKUP", color: "#ff6a1a26" },
      distance: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Dist", bind: "Pickup Distance", min: 0, max: 1 },
      axis: { type: "knob", col: 6, row: 2, colSpan: 2, rowSpan: 2, label: "Axis", bind: "Pickup Axis", min: 0, max: 1 },
      impedance: { type: "knob", col: 8, row: 2, colSpan: 2, rowSpan: 2, label: "Imped", bind: "Impedance", min: 0, max: 1 },
      motion: { type: "group", col: 10, row: 0, colSpan: 6, rowSpan: 2, label: "MOD", color: "#3ec96b26" },
      tremolo: { type: "knob", col: 10, row: 0, colSpan: 2, rowSpan: 2, label: "Trem", bind: "Tremolo", min: 0, max: 1 },
      vibrato: { type: "knob", col: 12, row: 0, colSpan: 2, rowSpan: 2, label: "Vibrato", bind: "Vibrato", min: 0, max: 1 },
      vib_rate: { type: "knob", col: 14, row: 0, colSpan: 2, rowSpan: 2, label: "Rate", bind: "Vibrato Rate", min: 0, max: 1 },
      noises: { type: "group", col: 10, row: 2, colSpan: 6, rowSpan: 2, label: "NOISE", color: "#ffffff14" },
      hammer_noise: { type: "knob", col: 10, row: 2, colSpan: 2, rowSpan: 2, label: "Hammer", bind: "Hammer Noise", min: 0, max: 1 },
      release_noise: { type: "knob", col: 12, row: 2, colSpan: 2, rowSpan: 2, label: "Release", bind: "Key Release Noise", min: 0, max: 1 },
      pedal_noise: { type: "knob", col: 14, row: 2, colSpan: 2, rowSpan: 2, label: "Pedal", bind: "Sustain Pedal Noise", min: 0, max: 1 },
    }),
  name("EQ")
