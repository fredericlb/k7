      microphone: { type: "dropdown", col: 0, row: 3, colSpan: 6, label: "Mic", bind: "Guitar Amp Microphone", options: [label("SM57 off axis").value(0), label("SM57 on axis").value(0.3333333333333333), label("421 front").value(0.6666666666666666), label("U87 front").value(1)] },
