// panel for @k7-core/instruments/synth/art-korg-ms-20-v
cols(16)
rows(4)
widgets({})
tabs([
  name("Voice")
    .widgets({
      g_vco1: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 3, label: "VCO1", color: "#3d7dff26" },
      v1_wave: { type: "dropdown", col: 0, row: 0, colSpan: 2, label: "Wave", bind: "VCO 1 Waveform", options: [label("Triangle").value(0), label("Saw").value(0.3333333333333333), label("Pulse").value(0.6666666666666666), label("Noise").value(1)] },
      v1_scale: { type: "dropdown", col: 2, row: 0, colSpan: 2, label: "Scale", bind: "VCO 1 Scale", options: [label("32'").value(0), label("16'").value(0.3333333333333333), label("8'").value(0.6666666666666666), label("4'").value(1)] },
      v1_pw: { type: "knob", col: 0, row: 1, colSpan: 2, rowSpan: 2, label: "PW", bind: "VCO 1 Pulse Width", min: 0, max: 1 },
      v1_level: { type: "knob", col: 2, row: 1, colSpan: 2, rowSpan: 2, label: "Level", bind: "VCO 1 Level", min: 0, max: 1 },
      g_vco2: { type: "group", col: 4, row: 0, colSpan: 4, rowSpan: 3, label: "VCO2", color: "#3d7dff26" },
      v2_wave: { type: "dropdown", col: 4, row: 0, colSpan: 2, label: "Wave", bind: "VCO 2 Waveform", options: [label("Saw").value(0), label("Square").value(0.3333333333333333), label("Pulse").value(0.6666666666666666), label("Ring Mod").value(1)] },
      v2_scale: { type: "dropdown", col: 6, row: 0, colSpan: 2, label: "Scale", bind: "VCO 2 Scale", options: [label("16'").value(0), label("8'").value(0.3333333333333333), label("4'").value(0.6666666666666666), label("2'").value(1)] },
      v2_pitch: { type: "knob", col: 4, row: 1, colSpan: 2, rowSpan: 2, label: "Pitch", bind: "VCO 2 Pitch", min: 0, max: 1 },
      v2_level: { type: "knob", col: 6, row: 1, colSpan: 2, rowSpan: 2, label: "Level", bind: "VCO 2 Level", min: 0, max: 1 },
      g_osc: { type: "group", col: 0, row: 3, colSpan: 8, label: "OSC", color: "#3d7dff26" },
      v_sync: { type: "toggle", col: 0, row: 3, colSpan: 2, label: "Sync", bind: "VCO Sync" },
      fm_assign: { type: "dropdown", col: 2, row: 3, colSpan: 6, label: "FM to", bind: "VCO FM Assign", options: [label("VCO 1").value(0), label("VCO 1+2").value(0.5), label("VCO 2").value(1)] },
    }),
  name("Filter")
    .widgets({
      g_hpf: { type: "group", col: 0, row: 0, colSpan: 8, rowSpan: 2, label: "HPF", color: "#ff6a1a26" },
      hp_cut: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Cutoff", bind: "HPF Cutoff Frequency", min: 0, max: 1 },
      hp_peak: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Peak", bind: "HPF Peak", min: 0, max: 1 },
      hp_mg: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "MG", bind: "HPF Modulation Amount", min: 0, max: 1 },
      hp_eg: { type: "knob", col: 6, row: 0, colSpan: 2, rowSpan: 2, label: "EG2", bind: "HPF Total Modulation Amount", min: 0, max: 1 },
      g_lpf: { type: "group", col: 0, row: 2, colSpan: 8, rowSpan: 2, label: "LPF", color: "#ff6a1a26" },
      lp_cut: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Cutoff", bind: "LPF Cutoff Frequency", min: 0, max: 1 },
      lp_peak: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Peak", bind: "LPF Peak", min: 0, max: 1 },
      lp_mg: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "MG", bind: "LPF Modulation Amount", min: 0, max: 1 },
      lp_eg: { type: "knob", col: 6, row: 2, colSpan: 2, rowSpan: 2, label: "EG2", bind: "LPF Total Modulation Amount", min: 0, max: 1 },
      filter_screen: { type: "lcdscreen", col: 8, row: 0, colSpan: 8, rowSpan: 3 },
      g_flt: { type: "group", col: 8, row: 3, colSpan: 8, label: "VCF", color: "#6b6b6b33" },
      flt_rev: { type: "dropdown", col: 8, row: 3, colSpan: 4, label: "Rev", bind: "Filter Revision", options: [label("MKI").value(0), label("MKII").value(1)] },
      flt_link: { type: "dropdown", col: 12, row: 3, colSpan: 4, label: "Link", bind: "Cutoff Link", options: [label("Same").value(0), label("Off").value(0.5), label("Opposite").value(1)] },
    }),
  name("Env")
    .widgets({
      g_eg1: { type: "group", col: 0, row: 0, colSpan: 8, rowSpan: 2, label: "EG1", color: "#3ec96b26" },
      eg1_delay: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Delay", bind: "EG1 Delay Time", min: 0, max: 1 },
      eg1_atk: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Attack", bind: "EG1 Attack Time", min: 0, max: 1 },
      eg1_rel: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Release", bind: "EG1 Release Time", min: 0, max: 1 },
      eg1_fm: { type: "knob", col: 6, row: 0, colSpan: 2, rowSpan: 2, label: "EG>Pit", bind: "VCO Frequency Modulation (2)", min: 0, max: 1 },
      g_eg2: { type: "group", col: 0, row: 2, colSpan: 10, rowSpan: 2, label: "EG2", color: "#3ec96b26" },
      eg2_hold: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Hold", bind: "EG2 Hold Time", min: 0, max: 1 },
      eg2_atk: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Attack", bind: "EG2 Attack Time", min: 0, max: 1 },
      eg2_dec: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Decay", bind: "EG2 Decay Time", min: 0, max: 1 },
      eg2_sus: { type: "knob", col: 6, row: 2, colSpan: 2, rowSpan: 2, label: "Sustain", bind: "EG2 Sustain Level", min: 0, max: 1 },
      eg2_rel: { type: "knob", col: 8, row: 2, colSpan: 2, rowSpan: 2, label: "Release", bind: "EG2 Release Time", min: 0, max: 1 },
      env_screen: { type: "lcdscreen", col: 10, row: 0, colSpan: 6, rowSpan: 4 },
    }),
  name("Mod")
    .widgets({
      g_mg: { type: "group", col: 0, row: 0, colSpan: 8, rowSpan: 2, label: "MG", color: "#6b6b6b33" },
      mg_wave: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Wave", bind: "MG Waveform", min: 0, max: 1 },
      mg_freq: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Freq", bind: "MG Frequency", min: 0, max: 1 },
      mg_fm: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "MG>Pit", bind: "VCO Frequency Modulation", min: 0, max: 1 },
      mg_pwm: { type: "knob", col: 6, row: 0, colSpan: 2, rowSpan: 2, label: "PWM", bind: "VCO Pulse Width Modulation", min: 0, max: 1 },
      g_play: { type: "group", col: 0, row: 2, colSpan: 6, rowSpan: 2, label: "PLAY", color: "#ffffff14" },
      porta: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Glide", bind: "Portamento Time", min: 0, max: 1 },
      velo: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Velo", bind: "Velocity", min: 0, max: 1 },
      detune: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Detune", bind: "Unison Detune", min: 0, max: 1 },
      mg_screen: { type: "lcdscreen", col: 8, row: 0, colSpan: 8, rowSpan: 4 },
    }),
])
