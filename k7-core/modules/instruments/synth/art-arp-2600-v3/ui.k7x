      fdbk: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Fdbk", bind: "Delay FeedBack Left", min: 0, max: 1 },
      reverb: { type: "knob", col: 6, row: 2, colSpan: 2, rowSpan: 2, label: "Reverb", bind: "Amount Left Reverb", min: 0, max: 1 },
