// "title" — a line of text. `content` is the words and `font` the CSS family; both are FIELDS,
// a knob having nothing to say about a string. `font_size` is a param like the position.
type("shape")
shape("text")
content("st0")
font("sans-serif")
color("#ffffff")
params({ x: 40, y: 560, font_size: 72 })
