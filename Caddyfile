# studio's dev sites. Site blocks ONLY — the global options block lives in
# commons/caddy/global.caddy, because only one may exist per Caddyfile and one
# Caddy serves both monorepos. `npm run caddy` merges this with phare's.


# The audio side, one origin, one path per service — mirroring the production
# shape (studio.frediver.se/<service>). Each SPA sets a matching vite `base`.
#
# The API handles STRIP the service prefix; the SPA handles do NOT. That
# asymmetry is the whole trick and is not a style choice:
#
#   * the backend must keep seeing `/api/...` as it does today, so the prefix
#     comes off before it — the same thing the production edge does;
#   * the dev server must keep seeing the prefix, because vite serves its assets
#     under `base`. Strip it and every asset request 404s against a server that
#     is only listening at /<service>/.
#
# st0 is the exception and needs neither half: it has NO prefix. The médiathèque
# is the studio's home page, so it answers at `/api/*` and at the bare origin,
# and both of its handles are plain proxies. Nothing else may claim a prefixless
# path — one origin can only have one root.
#
# Ordering is load-bearing too: handle blocks are mutually exclusive and matched
# top to bottom, so each service's API rule must precede its catch-all, and st0's
# root catch-all must come dead last or it swallows every other service.
studio.test {
	tls internal

	# No HTTP/3 advertisement, PROVEN necessary: a browser on another LAN machine
	# upgrades to QUIC and its WebSockets fail (console, Tilt, vscode terminals)
	# while plain pages sail through — "page ok, ws injoignable". Same page in a
	# private window (no cached Alt-Svc mapping) works. A browser that saw the old
	# header may cling to h3 for up to its 30-day ma= — a full browser restart
	# clears it. Local to this site block on purpose: the global options live in
	# commons, and phare has no LAN WebSocket surface to protect.
	header -Alt-Svc

	# Auth is ORIGIN-WIDE, not per service: one origin means one session cookie, so
	# one backend owns the flow and the others merely verify its cookie. It also
	# leaves a single redirect_uri to register — redirectUriFor already builds
	# <origin>/auth/callback with no prefix, which only works if this handle exists.
	# First, because the service handles below would otherwise swallow nothing here
	# but order is what guarantees it stays that way.
	#
	# It points at st0 (8795), the service that OWNS the origin root. That is not a
	# preference: the prefixless redirect_uri above belongs to whoever has no prefix,
	# and st0 is the only one. l8 held this while the bare origin merely redirected
	# to it, and now passes mountRoutes: [] like m9 and k7 always have. z0 was the
	# last exception and is one no longer: it ran its own flow under /z0 until the
	# IdP refused the prefixed callback it implied (apps/z0/docs/auth.md).
	handle /auth/* {
		reverse_proxy 127.0.0.1:8795
	}

	@l8_api path /l8/api/*
	handle @l8_api {
		uri strip_prefix /l8
		reverse_proxy 127.0.0.1:8789
	}
	@l8 path /l8 /l8/*
	handle @l8 {
		reverse_proxy 127.0.0.1:5223
	}

	# st0 — the media library, hosted, and the studio's HOME PAGE. It has no path of
	# its own: its API is `/api/*` at the root and its SPA is the catch-all at the
	# bottom of this block, so the prefix asymmetry the other services need does not
	# apply and there is nothing to strip. The catalogue and the bytes both come from
	# its own backend; the local cache the moteur plays from is not served here.
	#
	# This rule sits with the other API rules rather than beside its catch-all
	# because `/api/*` must be matched before the bare `handle` at the bottom — which
	# is the whole reason that one has to stay last.
	@st0_api path /api/*
	handle @st0_api {
		reverse_proxy 127.0.0.1:8795
	}

	# The decks. Its backend holds auth, the engine registry and which machine
	# the account DJs from; the file service and the engine it plays through are
	# reached directly, cross-origin, so neither is proxied here.
	@m9_api path /m9/api/*
	handle @m9_api {
		uri strip_prefix /m9
		reverse_proxy 127.0.0.1:8796
	}
	@m9 path /m9 /m9/*
	handle @m9 {
		reverse_proxy 127.0.0.1:5225
	}

	# The cut. Its backend holds auth, the machine registry and which machine the
	# account works from; the file service that holds the project AND the footage is
	# reached directly, cross-origin, so it is not proxied here. There is no moteur
	# in this app's picture at all — a cut has no audio.
	@v1_api path /v1/api/*
	handle @v1_api {
		uri strip_prefix /v1
		reverse_proxy 127.0.0.1:8790
	}
	@v1 path /v1 /v1/*
	handle @v1 {
		reverse_proxy 127.0.0.1:5226
	}

	# --- z0: guests are its own, the ACCOUNT login is st0's -------------
	# It keeps `bt_session` for guests — a blind-test player has no account, a
	# kind the studio session does not model — but no longer runs an OIDC flow.
	# X-Forwarded-Prefix used to be set here, and ONLY here, so redirectUriFor
	# would name /z0/auth/callback; the IdP has only the prefixless callback
	# registered, so that URI was refused and no account could sign in at all.
	# /z0/auth/* still reaches this backend: me, guest and logout live there.
	# See apps/z0/docs/auth.md.
	@z0_api path /z0/api/*
	handle @z0_api {
		uri strip_prefix /z0/api
		reverse_proxy 127.0.0.1:8080
	}
	@z0_backend path /z0/auth/* /z0/audio/* /z0/ws*
	handle @z0_backend {
		uri strip_prefix /z0
		reverse_proxy 127.0.0.1:8080
	}
	# The five path-routed SPAs, then the apex one. No strip: each vite `base` is
	# the full public path, so the dev server must see it.
	@z0_buzzer path /z0/buzzer /z0/buzzer/*
	handle @z0_buzzer {
		reverse_proxy 127.0.0.1:3004
	}
	@z0_remote path /z0/remote /z0/remote/*
	handle @z0_remote {
		reverse_proxy 127.0.0.1:3005
	}
	# editor-v2 BEFORE editor: handle blocks match top to bottom, and `/z0/editor/*` would
	# not swallow `/z0/editor-v2` anyway (the segment differs), but keeping the more specific
	# one first is what makes that safe to read. When v2 takes over, this pair becomes one.
	@z0_editor_v2 path /z0/editor-v2 /z0/editor-v2/*
	handle @z0_editor_v2 {
		reverse_proxy 127.0.0.1:3007
	}
	@z0_editor path /z0/editor /z0/editor/*
	handle @z0_editor {
		reverse_proxy 127.0.0.1:3006
	}
	@z0_presenter path /z0/presenter /z0/presenter/*
	handle @z0_presenter {
		reverse_proxy 127.0.0.1:3001
	}
	@z0_monitor path /z0/monitor /z0/monitor/*
	handle @z0_monitor {
		reverse_proxy 127.0.0.1:3002
	}
	@z0 path /z0 /z0/*
	handle @z0 {
		reverse_proxy 127.0.0.1:3003
	}

	# --- k7, served at /k7 ----------------------------------------------
	# Joins the shared session: a plain OIDC one, no guest kinds, so there is
	# nothing here that the studio cookie cannot carry. The path was already `/k7`
	# while the app was still called radiok7; the name caught up with it.
	@k7_api path /k7/api/* /k7/rtc*
	handle @k7_api {
		uri strip_prefix /k7
		reverse_proxy 127.0.0.1:8787
	}
	@k7 path /k7 /k7/*
	handle @k7 {
		reverse_proxy 127.0.0.1:5173
	}

	# --- VS Code in the browser, served at /dev -----------------------------
	# A root turbo task started by `npm run dev` (and alone by `npm run vscode`).
	# No strip: `code serve-web --server-base-path /dev` already serves under the
	# prefix, the same asymmetry as the SPAs above.
	#
	# UNAUTHENTICATED, on purpose — a dev-only choice for an open-source repo. This
	# route is a shell on the repo root and this Caddy answers on every interface,
	# so do not carry the block to anything reachable. scripts/vscode.mjs says how
	# to put a connection token back.
	@vscode path /dev /dev/*
	handle @vscode {
		reverse_proxy 127.0.0.1:8798
	}

	# --- The shared shell, served at /console -------------------------------
	# scripts/console/server.mjs — ONE PowerShell in a ConPTY the service owns (a
	# logon task installed by scripts/remote.mjs), so it survives its viewers and
	# every browser types into the SAME terminal. The Tilt UI (:10351 below) has
	# no stdin; this is its terminal-shaped companion. No strip: the server serves
	# under the prefix, same asymmetry as the SPAs. UNAUTHENTICATED like /dev, for
	# the same stated reasons and with the same warning. See docs/remote.md.
	@console path /console /console/*
	handle @console {
		reverse_proxy 127.0.0.1:8797
	}

	# --- /dev-status → the Tilt UI ------------------------------------------
	# A REDIRECT, not a proxy: Tilt's SPA loads /static/* absolute and `tilt up`
	# has no base-path flag (checked: only --host/--port), so it cannot join the
	# path-per-service scheme. This just gives its port site below a memorable
	# name on the origin.
	@devstatus path /dev-status /dev-status/*
	handle @devstatus {
		redir * https://studio.test:10351/
	}

	# The bare origin IS st0 — the médiathèque is the studio's front door, not a
	# redirect to somewhere else. This is also where OIDC's APP_ROOT fallback lands
	# when a login carries no return_to, which now arrives at a real page instead of
	# being bounced on to l8.
	#
	# LAST, and unmatched: `handle` blocks are mutually exclusive and matched top to
	# bottom, so every prefixed service above claims its own paths first and whatever
	# is left is st0's. No strip — vite's `base` is "/" here, so there is no prefix
	# to take off, which is the one case where the asymmetry at the top of this file
	# has nothing to say.
	handle {
		reverse_proxy 127.0.0.1:5224
	}
}

# The Tilt UI — the dev session's control panel (per-task logs, status and restart;
# started by the studio-tilt logon task, scripts/remote.mjs). Its SPA assumes it is
# served at the root, so it cannot join the path-per-service scheme above: it gets a
# PORT on the same hostname instead — no new DNS name to resolve, same internal CA.
# Same no-auth stance as /dev and /console.
studio.test:10351 {
	tls internal
	header -Alt-Svc
	reverse_proxy 127.0.0.1:10350
}
