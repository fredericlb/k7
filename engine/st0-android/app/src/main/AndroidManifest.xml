<?xml version="1.0" encoding="utf-8"?>
<!-- The backend and the engine live exactly as long as MainActivity; the one service only keeps that process in front while a page plays (docs/android.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine's WebSocket server, which browsers on the LAN dial; and the studio apps, loaded from the studio — this phone's own, or another. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The IPv4 the activity shows, so a browser knows what to dial. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The engine opens the device WITH its inputs (docs/engineHost.md); Oboe wants both below. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- MediaPlaybackService: the process kept in front while a page plays, screen off or app behind another. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="false"
        android:label="st0"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme.NoActionBar">
        <!-- configChanges: a rotation must not recreate the activity, which would stop the engine. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The browser's answer to a sign-in (AuthHandoff.kt); singleTask, so it reaches the running activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="se.frediver.st0" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- Holds the process in front while a page plays; MediaPlayback.kt is the session it shows. -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The media notification's own buttons, which Android 12 and older draw instead of the session's. -->
        <receiver
            android:name=".MediaPlayback$Buttons"
            android:exported="false" />
    </application>
</manifest>
