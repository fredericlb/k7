{
  "name": "st0-tray",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "st0 menu-bar / system-tray view (Tauri v2, native Rust) over the native supervisor, engine/st0-supervisor, which it spawns and drives over NDJSON on stdio.",
  "scripts": {
    "predev": "node scripts/build-engine.mjs --sidecar-only",
    "dev": "tauri dev",
    "prebuild": "node scripts/build-engine.mjs --sidecar-only",
    "build": "tauri build",
    "tauri": "tauri",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:dev": "node scripts/build-engine.mjs --dev",
    "engine:sidecar": "node scripts/build-engine.mjs --sidecar-only",
    "engine:package": "node scripts/package-release.mjs",
    "engine:portable": "node scripts/build-portable.mjs",
    "engine:start": "node scripts/start-engine.mjs",
    "engine:buildstart": "npm run engine:dev && npm run engine:start",
    "tray:restart": "node scripts/restart-tray.mjs",
    "tray:stop": "node scripts/restart-tray.mjs --stop"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
