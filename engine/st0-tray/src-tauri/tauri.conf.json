{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "st0-tray",
  "version": "0.0.1",
  "identifier": "org.parapluie.studio.engine-tray",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/st0-engine", "binaries/node"],
    "resources": [
      "resources/engine-host.mjs",
      "resources/faust-libs",
      "resources/node_modules"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
