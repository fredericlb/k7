{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{STUDIO_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{STUDIO_COMPILER_LAUNCHER}"
      }
    },
    {
      "name": "dev-gcc",
      "displayName": "Dev (GCC)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "dev-clang",
      "displayName": "Dev (Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release-gcc",
      "displayName": "Release (GCC)",
      "inherits": "dev-gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC 2026)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows (MSVC, Ninja) — CI",
      "description": "windows-msvc under Ninja, for CI's compiler cache; the engine's preset of the same name says why.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "CMAKE_POLICY_DEFAULT_CMP0141": "NEW"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS (AppleClang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android (NDK, arm64-v8a)",
      "description": "The supervisor as an executable the Android app (engine/k7-android) runs from its native library directory, driving it over the supervisor's NDJSON stdio protocol, as the desktop app does. Needs ANDROID_NDK_HOME pointing at an NDK r28+. No ONNX Runtime ships for Android, so no stem separation. engine/k7-runtime/docs/android.md.",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "ios-arm64",
      "displayName": "iOS (arm64 device)",
      "description": "The supervisor as a framework, k7supervisor.framework, which the iOS app (engine/k7-ios) embeds and runs on a thread of its own over the same NDJSON a desktop app speaks on stdio: an iOS app may run no program of its own. Needs a full Xcode. No ONNX Runtime ships for iOS as a library this loads, so no stem separation. engine/k7-runtime/docs/ios.md.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "ios-sim-arm64",
      "displayName": "iOS Simulator (arm64)",
      "description": "ios-arm64 for the simulator on an Apple Silicon Mac, which is where the app is driven before a phone.",
      "inherits": "ios-arm64",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    }
  ],
  "buildPresets": [
    { "name": "dev-gcc", "configurePreset": "dev-gcc" },
    { "name": "dev-clang", "configurePreset": "dev-clang" },
    { "name": "release-gcc", "configurePreset": "release-gcc" },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "RelWithDebInfo"
    },
    { "name": "windows-msvc-ninja", "configurePreset": "windows-msvc-ninja" },
    { "name": "macos-clang", "configurePreset": "macos-clang" },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": ["k7-supervisor"]
    },
    { "name": "ios-arm64", "configurePreset": "ios-arm64", "targets": ["k7-supervisor-embedded"] },
    { "name": "ios-sim-arm64", "configurePreset": "ios-sim-arm64", "targets": ["k7-supervisor-embedded"] }
  ]
}
