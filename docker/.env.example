# Copy to .env beside docker-compose.yml, fill in, then `docker compose up -d`.

# The tag to pull/build — CI pushes :latest, :<commit>, and a YY.MMDDHHmm build
# stamp. Pin to a stamp or commit for a reproducible deploy.
APP_VERSION=latest

# Cookie signing secret. Has an insecure default in code — always set this.
SESSION_SECRET=

# Identity provider — leave all three empty to run the dev-auth stub instead
# ("Dev User", no real login). See commons/packages/oidc/index.ts.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=

# z0's backend only. Unset is none, e.g. EXTRA_FLAGS=--latest
EXTRA_FLAGS=

# --- Traefik / three-hostname deployment ------------------------------------
# Four containers, three public hostnames (see docker-compose.yml's labels):
# st0 at the root domain, k7 and pl8 each on their own subdomain, and z0 — still
# unmoved — riding along under st0's own domain at /z0, its own container.
ST0_DOMAIN=st0.app
K7_DOMAIN=k7.st0.app
PL8_DOMAIN=play.st0.app
# Your Traefik instance's certificate resolver name (traefik.toml / static
# config), e.g. the ACME resolver you registered there.
TRAEFIK_CERTRESOLVER=letsencrypt

# `Domain=` for the session cookie so it's shared across the three hosts
# above instead of host-only, e.g. ".st0.app" (leading dot) — every
# setupAuth() call picks this up automatically (commons/packages/oidc).
# PRODUCTION ONLY: setting it forces Secure+SameSite=None, which browsers
# silently drop over plain http — never set this for local dev over
# http://localhost.
COOKIE_DOMAIN=

# pl8's CORS allowlist for the other two origins calling its API directly —
# comma-separated, e.g. "https://st0.app,https://k7.st0.app". Also what st0's
# own login flow bounces back to when it's reached from k7's or pl8's
# subdomain (safeReturnTarget, commons/packages/oidc) — include BOTH
# ST0_DOMAIN's siblings here for that to work end to end.
TRUSTED_ORIGINS=
