# Copy to .env beside docker-compose.yml, fill in, then `docker compose up -d`.

# The tag to pull/build — CI pushes :latest, :<commit>, and a YY.MMDDHHmm build
# stamp. Pin to a stamp or commit for a reproducible deploy.
APP_VERSION=latest
# The z0 image's tag. z0 is built by its own repository, which stamps it the same
# way; pin it independently of APP_VERSION.
Z0_VERSION=latest

# Cookie signing secret, at least 32 characters (`openssl rand -hex 32`); k7
# refuses to start without one (apps/k7/backend/docs/hardening.md).
SESSION_SECRET=

# Identity provider. OIDC_ISSUER and OIDC_CLIENT_ID are required: without them
# k7 refuses to start rather than sign every visitor in as one "Dev User".
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=

# z0's backend only. Unset is none, e.g. EXTRA_FLAGS=--latest
EXTRA_FLAGS=

# Comma-separated IdP group names. In z0, without at least one, nobody's
# session admits them to the editor, presenter, monitor or remote surfaces; in
# k7 they edit the shared libraries and delete a public rehearsal song.
AUTH_ADMIN_GROUPS=

# --- Token secrets (see docs/tokens.md) --------------------------------------
# The media library's bearer tokens. Unset derives one from SESSION_SECRET.
API_TOKEN_SECRET=
# The rehearsal recorder's personal tokens, saved in users' settings. Leave it
# unset to keep the default derived from SESSION_SECRET that k7 always used:
# changing it invalidates every token already issued.
K7_API_TOKEN_SECRET=

# --- The server's engine (docs/server-engine.md) ------------------------------
# Shared by k7 and the engine service: the engine presents it when it dials k7,
# and k7 then renders on it whatever it cannot render itself — exports, shares,
# freezes, splits. A long random string (`openssl rand -hex 32`); unset, k7
# renders only on an account's own bound engine.
RENDER_KEY=
# The name the engine pickers show for it.
ENGINE_NAME=k7 server

# --- The rehearsal recorder's former PocketBase -------------------------------
# Only for k7's one-time import into k7.db (packages/rehearsal-server/docs/store.md): the
# pocketbase service's superuser. Drop all three once k7 has logged "rehearsal: imported …".
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
# Published on the host's 127.0.0.1 only, for the admin UI through an SSH tunnel.
POCKETBASE_PORT=8090

# --- Traefik / hostnames ------------------------------------------------------
# Every hostname is k7's (see docker-compose.yml's labels): the app, its
# documentation, and the former st0.app hosts that saved URLs, installed
# supervisors and public pages still name — their pages move to K7_DOMAIN, their
# API keeps answering (packages/web-protocol/docs/addresses.md).
# z0 rides along under k7's own domain at /z0, its own container.
K7_DOMAIN=app.k7.rocks
DOCS_DOMAIN=docs.k7.rocks
LEGACY_DOMAIN=st0.app
K7_ALIAS_DOMAIN=k7.st0.app
PL8_DOMAIN=play.st0.app
# Your Traefik instance's certificate resolver name (traefik.toml / static
# config), e.g. the ACME resolver you registered there.
TRAEFIK_CERTRESOLVER=letsencrypt

# `Domain=` for the session cookie, shared across subdomains instead of
# host-only, e.g. ".k7.rocks" (leading dot) — every setupAuth() call picks this
# up automatically (commons/packages/oidc). Empty is enough here: the docs host
# needs no session, and a cookie on k7.rocks cannot reach the st0.app hosts.
# PRODUCTION ONLY: setting it forces Secure+SameSite=None, which browsers
# silently drop over plain http — never set this for local dev over
# http://localhost.
COOKIE_DOMAIN=

# What k7's own login flow bounces back to when it's reached from another
# origin (safeReturnTarget, commons/packages/oidc) — comma-separated, e.g.
# "https://other.example". The former hosts redirect to K7_DOMAIN before anyone
# signs in, and the docs host has no sign-in, so neither needs an entry. Each origin listed may also call the
# API with the session cookie — apps/k7/backend/docs/media/cors.md.
TRUSTED_ORIGINS=
