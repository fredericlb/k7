# Copy to .env beside docker-compose.yml, fill in, then `docker compose up -d`.

# The tag to pull/build — CI pushes :latest, :<commit>, and a YY.MMDDHHmm build
# stamp. Pin to a stamp or commit for a reproducible deploy.
APP_VERSION=latest
# The z0 image's tag. z0 is built by its own repository, which stamps it the same
# way; pin it independently of APP_VERSION.
Z0_VERSION=latest

# Cookie signing secret. Has an insecure default in code — always set this.
SESSION_SECRET=

# Identity provider — leave all three empty to run the dev-auth stub instead
# ("Dev User", no real login). See commons/packages/oidc/index.ts.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=

# z0's backend only. Unset is none, e.g. EXTRA_FLAGS=--latest
EXTRA_FLAGS=

# Comma-separated IdP group names. In z0, without at least one, nobody's
# session admits them to the editor, presenter, monitor or remote surfaces; in
# st0 they edit the shared libraries and delete a public rehearsal song.
AUTH_ADMIN_GROUPS=

# --- Token secrets (see docs/tokens.md) --------------------------------------
# The media library's bearer tokens. Unset derives one from SESSION_SECRET.
API_TOKEN_SECRET=
# The rehearsal recorder's personal tokens, saved in users' settings. Leave it
# unset to keep the default derived from SESSION_SECRET that k7 always used:
# changing it invalidates every token already issued.
K7_API_TOKEN_SECRET=

# --- The rehearsal recorder's PocketBase store --------------------------------
# The pocketbase service's superuser — create it once with
# `docker compose exec pocketbase /pb/pocketbase superuser create <email> <password>`
# and put the same values here.
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
# The host port the admin web UI (/_/) and REST API (/api/*) are published on —
# both served by PocketBase on this one port. Change it only on a clash.
POCKETBASE_PORT=8090

# --- Traefik / three-hostname deployment ------------------------------------
# Three hostnames, all st0's (see docker-compose.yml's labels): the root domain,
# and the play. and k7. aliases that saved URLs and public pages still name.
# z0 rides along under st0's own domain at /z0, its own container.
ST0_DOMAIN=st0.app
K7_DOMAIN=k7.st0.app
PL8_DOMAIN=play.st0.app
# Your Traefik instance's certificate resolver name (traefik.toml / static
# config), e.g. the ACME resolver you registered there.
TRAEFIK_CERTRESOLVER=letsencrypt

# `Domain=` for the session cookie so it's shared across the three hosts
# above instead of host-only, e.g. ".st0.app" (leading dot) — every
# setupAuth() call picks this up automatically (commons/packages/oidc).
# PRODUCTION ONLY: setting it forces Secure+SameSite=None, which browsers
# silently drop over plain http — never set this for local dev over
# http://localhost.
COOKIE_DOMAIN=

# What st0's own login flow bounces back to when it's reached from another
# origin (safeReturnTarget, commons/packages/oidc) — comma-separated, e.g.
# "https://st0.app". The play. and k7. aliases redirect to ST0_DOMAIN before
# anyone signs in, so they need no entry. The media API answers every origin's
# CORS preflight regardless — apps/st0/backend/docs/media/cors.md.
TRUSTED_ORIGINS=
