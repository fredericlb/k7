// Déformées — Call me — les effets de la question, en chaîne. Le sidecar du morceau la nomme comme
// variante ; l'ordre des modules et la correspondance des valeurs sont dans
// apps/z0/docs/effects.md du dépôt studio.

steps([
  id("c080ae9f-ade3-4114-ba96-315fdfaba9a8")
    .extends("@st0/audio/zz_utility/pitch-shift")
    .params({ "semitones up": 6 }),
  id("637bfa75-c798-4225-8766-b9af60675410")
    .extends("@st0/audio/lowpass")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 57 } } }),
  id("ea0d5d21-bf5d-45f2-bb04-a9856ef0e961")
    .extends("@st0/audio/chorus")
    // The one-knob chorus the blind test was tuned on, not the module's default.
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 37 } } }),
  id("e85dec74-54d8-4309-b6c1-9ae5dd133f3a")
    .extends("@st0/audio/overdrive")
    .engine("one-knob")
    .engines({ one-knob: { params: { Amount: 1 } } }),
  to([chain("@out")]),
])
