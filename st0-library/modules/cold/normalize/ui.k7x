// normalize — peak normalisation of a recording, applied by the cold pass
cols(7)
rows(2)
widgets({
  target: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Target",
    bind: "Target",
    min: -60,
    max: 0,
  },
  peak: { type: "meter", col: 2, row: 0, rowSpan: 2, label: "Peak", bind: "Peak" },
  gain_screen: { type: "lcdscreen", col: 3, row: 0, colSpan: 4, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    target: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Target",
      bind: "Target",
      min: -60,
      max: 0,
    },
    peak: { type: "meter", col: 2, row: 0, rowSpan: 2, label: "Peak", bind: "Peak" },
    gain_screen: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 2 },
  },
})
