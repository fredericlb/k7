// pressure-4 — a compressor-limiter with a character control
cols(6)
rows(4)
widgets({
  levels: { type: "lcdscreen", col: 0, row: 0, colSpan: 6, rowSpan: 2 },
  comp_grp: {
    type: "group",
    col: 0,
    row: 2,
    colSpan: 6,
    rowSpan: 2,
    label: "COMP",
    color: "#3d7dff26",
  },
  pressure: {
    type: "knob",
    col: 0,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Pressure",
    bind: "Pressure",
    min: 0,
    max: 1,
  },
  speed: {
    type: "knob",
    col: 2,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Speed",
    bind: "Speed",
    min: 0,
    max: 1,
  },
  mewiness: {
    type: "knob",
    col: 4,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Mewi",
    bind: "Mewiness",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 6,
  widgets: {
    levels: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 2 },
    comp_grp: {
      type: "group",
      col: 0,
      row: 2,
      colSpan: 4,
      rowSpan: 4,
      label: "COMP",
      color: "#3d7dff26",
    },
    pressure: {
      type: "knob",
      col: 0,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Pressure",
      bind: "Pressure",
      min: 0,
      max: 1,
    },
    speed: {
      type: "knob",
      col: 2,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Speed",
      bind: "Speed",
      min: 0,
      max: 1,
    },
    mewiness: {
      type: "knob",
      col: 0,
      row: 4,
      colSpan: 2,
      rowSpan: 2,
      label: "Mewi",
      bind: "Mewiness",
      min: 0,
      max: 1,
    },
  },
})
