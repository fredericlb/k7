// crystal — Airwindows Crystal, a tone and drive colour
cols(6)
rows(2)
widgets({
  hard: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Hard", bind: "Hardnss", min: 0, max: 1 },
  person: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Person", bind: "Personl", min: 0, max: 1 },
  drive: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Drive", bind: "Drive", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    hard: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Hard", bind: "Hardnss", min: 0, max: 1 },
    person: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Person", bind: "Personl", min: 0, max: 1 },
    drive: { type: "knob", col: 1, row: 2, colSpan: 2, rowSpan: 2, label: "Drive", bind: "Drive", min: 0, max: 1 },
  },
})
