// melt — a smearing modulation, its depth and range
cols(4)
rows(2)
widgets({
  depth: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Depth",
    bind: "Depth",
    min: 0,
    max: 1,
  },
  range: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Range",
    bind: "Range",
    min: 0,
    max: 1,
  },
})
