// flanger — a short delay swept by an LFO and fed back into itself
cols(8)
rows(4)
widgets({
  lfo_section: {
    type: "group",
    col: 0,
    row: 0,
    colSpan: 4,
    rowSpan: 2,
    label: "LFO",
    color: "#3d7dff26",
  },
  rate: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Rate",
    bind: "Rate",
    min: 0.05,
    max: 10,
    curve: "log",
  },
  depth: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Depth",
    bind: "Depth",
    min: 0,
    max: 8,
  },
  comb_section: {
    type: "group",
    col: 4,
    row: 0,
    colSpan: 4,
    rowSpan: 2,
    label: "COMB",
    color: "#ff6a1a26",
  },
  centre: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Centre",
    bind: "Centre",
    min: 0.5,
    max: 12,
  },
  feedback: {
    type: "knob",
    col: 6,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Fdbk",
    bind: "Feedback",
    min: 0,
    max: 0.9,
  },
  comb: { type: "lcdscreen", col: 0, row: 2, colSpan: 8, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 6,
  widgets: {
    lfo_section: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 4,
      rowSpan: 2,
      label: "LFO",
      color: "#3d7dff26",
    },
    rate: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Rate",
      bind: "Rate",
      min: 0.05,
      max: 10,
      curve: "log",
    },
    depth: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Depth",
      bind: "Depth",
      min: 0,
      max: 8,
    },
    comb_section: {
      type: "group",
      col: 0,
      row: 2,
      colSpan: 4,
      rowSpan: 2,
      label: "COMB",
      color: "#ff6a1a26",
    },
    centre: {
      type: "knob",
      col: 0,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Centre",
      bind: "Centre",
      min: 0.5,
      max: 12,
    },
    feedback: {
      type: "knob",
      col: 2,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Fdbk",
      bind: "Feedback",
      min: 0,
      max: 0.9,
    },
    comb: { type: "lcdscreen", col: 0, row: 4, colSpan: 4, rowSpan: 2 },
  },
})
