// air — a high-frequency air boost from three taps at 11, 15 and 22 kHz
cols(5)
rows(3)
widgets({
  taps_section: {
    type: "group",
    col: 0,
    row: 0,
    colSpan: 3,
    rowSpan: 3,
    label: "AIR",
    color: "#3ec96b26",
  },
  tap_11k: {
    type: "fader",
    col: 0,
    row: 0,
    rowSpan: 3,
    label: "11K",
    bind: "11K tap",
    min: 0,
    max: 1,
  },
  tap_15k: {
    type: "fader",
    col: 1,
    row: 0,
    rowSpan: 3,
    label: "15K",
    bind: "15K tap",
    min: 0,
    max: 1,
  },
  tap_22k: {
    type: "fader",
    col: 2,
    row: 0,
    rowSpan: 3,
    label: "22K",
    bind: "22K tap",
    min: 0,
    max: 1,
  },
  q: {
    type: "knob",
    col: 3,
    row: 0,
    colSpan: 2,
    rowSpan: 3,
    label: "Q",
    bind: "filters Q",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 5,
  widgets: {
    taps_section: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 3,
      rowSpan: 3,
      label: "AIR",
      color: "#3ec96b26",
    },
    tap_11k: {
      type: "fader",
      col: 0,
      row: 0,
      rowSpan: 3,
      label: "11K",
      bind: "11K tap",
      min: 0,
      max: 1,
    },
    tap_15k: {
      type: "fader",
      col: 1,
      row: 0,
      rowSpan: 3,
      label: "15K",
      bind: "15K tap",
      min: 0,
      max: 1,
    },
    tap_22k: {
      type: "fader",
      col: 2,
      row: 0,
      rowSpan: 3,
      label: "22K",
      bind: "22K tap",
      min: 0,
      max: 1,
    },
    q: {
      type: "knob",
      col: 0,
