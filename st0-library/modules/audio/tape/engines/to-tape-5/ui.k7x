// to-tape-5 — tape recording saturation
cols(4)
rows(4)
widgets({
  sat: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "SAT", color: "#ff6a1a26" },
  louder: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Louder",
    bind: "Louder",
    min: 0,
    max: 1,
  },
  softer: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Softer",
    bind: "Softer",
    min: 0,
    max: 1,
  },
  tape: { type: "group", col: 0, row: 2, colSpan: 4, rowSpan: 2, label: "TAPE", color: "#3d7dff26" },
  fatter: {
    type: "knob",
    col: 0,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Fatter",
    bind: "Fatter",
    min: 0,
    max: 1,
  },
  flutter: {
    type: "knob",
    col: 2,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Flutter",
    bind: "Flutter",
    min: 0,
    max: 1,
  },
})
