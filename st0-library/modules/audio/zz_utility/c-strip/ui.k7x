// c-strip — Airwindows CStrip, a console channel strip
cols(13)
rows(4)
widgets({
  filt: { type: "group", col: 0, row: 0, colSpan: 2, rowSpan: 4, label: "FILT", color: "#3ec96b22" },
  hipass: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "HiPass",
    bind: "Hipass",
    min: 0,
    max: 1,
  },
  lowpass: {
    type: "knob",
    col: 0,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "LoPass",
    bind: "Lowpass",
    min: 0,
    max: 1,
  },
  eq: { type: "group", col: 2, row: 0, colSpan: 5, rowSpan: 4, label: "EQ", color: "#3d7dff26" },
  bass: { type: "fader", col: 2, row: 0, rowSpan: 4, label: "Bass", bind: "Bass", min: 0, max: 1 },
  mid: { type: "fader", col: 3, row: 0, rowSpan: 4, label: "Mid", bind: "Mid", min: 0, max: 1 },
  treble: {
    type: "fader",
    col: 4,
    row: 0,
    rowSpan: 4,
    label: "Treble",
    bind: "Treble",
    min: 0,
    max: 1,
  },
  bass_frq: {
    type: "knob",
    col: 5,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "BassFrq",
    bind: "BassFrq",
    min: 0,
    max: 1,
  },
  treb_frq: {
    type: "knob",
    col: 5,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "TrebFrq",
    bind: "TrebFrq",
    min: 0,
    max: 1,
  },
  dyn: { type: "group", col: 7, row: 0, colSpan: 4, rowSpan: 4, label: "DYN", color: "#ff6a1a22" },
  gate: {
    type: "knob",
    col: 7,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Gate",
    bind: "Gate",
    min: 0,
    max: 1,
  },
  comp: {
    type: "knob",
    col: 9,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Comp",
    bind: "Compres",
    min: 0,
    max: 1,
  },
  comp_spd: {
    type: "knob",
    col: 9,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Speed",
    bind: "CompSpd",
    min: 0,
    max: 1,
  },
  time_lag: {
    type: "knob",
    col: 11,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Lag",
    bind: "TimeLag",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 11,
  widgets: {
    filt: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 4,
      rowSpan: 2,
      label: "FILT",
      color: "#3ec96b22",
    },
    hipass: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "HiPass",
      bind: "Hipass",
      min: 0,
      max: 1,
    },
    lowpass: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "LoPass",
      bind: "Lowpass",
      min: 0,
      max: 1,
    },
    eq: { type: "group", col: 0, row: 2, colSpan: 4, rowSpan: 5, label: "EQ", color: "#3d7dff26" },
    bass: { type: "fader", col: 0, row: 2, rowSpan: 3, label: "Bass", bind: "Bass", min: 0, max: 1 },
    mid: { type: "fader", col: 1, row: 2, rowSpan: 3, label: "Mid", bind: "Mid", min: 0, max: 1 },
    treble: {
      type: "fader",
      col: 2,
      row: 2,
      rowSpan: 3,
      label: "Treble",
      bind: "Treble",
      min: 0,
      max: 1,
    },
    bass_frq: {
      type: "knob",
      col: 0,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "BassFrq",
      bind: "BassFrq",
      min: 0,
      max: 1,
    },
    treb_frq: {
      type: "knob",
      col: 2,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "TrebFrq",
      bind: "TrebFrq",
      min: 0,
      max: 1,
    },
    dyn: { type: "group", col: 0, row: 7, colSpan: 4, rowSpan: 4, label: "DYN", color: "#ff6a1a22" },
    gate: {
      type: "knob",
      col: 0,
      row: 7,
      colSpan: 2,
      rowSpan: 2,
      label: "Gate",
      bind: "Gate",
      min: 0,
      max: 1,
    },
    comp: {
      type: "knob",
      col: 2,
      row: 7,
      colSpan: 2,
      rowSpan: 2,
      label: "Comp",
      bind: "Compres",
      min: 0,
      max: 1,
    },
    comp_spd: {
      type: "knob",
      col: 0,
      row: 9,
      colSpan: 2,
      rowSpan: 2,
      label: "Speed",
      bind: "CompSpd",
      min: 0,
      max: 1,
    },
    time_lag: {
      type: "knob",
      col: 2,
      row: 9,
      colSpan: 2,
      rowSpan: 2,
      label: "Lag",
      bind: "TimeLag",
      min: 0,
      max: 1,
    },
  },
})
