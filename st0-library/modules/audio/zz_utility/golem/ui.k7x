      max: 1,
    },
    offset: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Offset",
      bind: "Offset",
      min: 0,
      max: 1,
    },
    phase: {
