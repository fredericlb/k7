// noise — Airwindows Noise, a shaped noise generator
cols(10)
rows(3)
widgets({
  filt: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, color: "#3ec96b22", label: "FILT" },
  low_cut: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "LowCut",
    bind: "LowCut",
    min: 0,
    max: 1,
  },
  high_cut: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "HighCut",
    bind: "HighCut",
    min: 0,
    max: 1,
  },
  shape: {
    type: "group",
    col: 4,
    row: 0,
    colSpan: 6,
    rowSpan: 2,
    color: "#ffffff14",
    label: "SHAPE",
  },
  lshape: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "LShape",
    bind: "LShape",
    min: 0,
    max: 1,
  },
  decay: {
    type: "knob",
    col: 6,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Decay",
    bind: "Decay",
    min: 0,
    max: 1,
  },
  distance: {
    type: "knob",
    col: 8,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Dist",
    bind: "Distnc",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 6,
  widgets: {
    filt: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 4,
      rowSpan: 2,
      color: "#3ec96b22",
      label: "FILT",
    },
    low_cut: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "LowCut",
      bind: "LowCut",
      min: 0,
      max: 1,
    },
    high_cut: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "HighCut",
      bind: "HighCut",
      min: 0,
      max: 1,
    },
    shape: {
      type: "group",
      col: 0,
      row: 2,
      colSpan: 4,
      rowSpan: 4,
      color: "#ffffff14",
      label: "SHAPE",
    },
    lshape: {
      type: "knob",
      col: 0,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "LShape",
      bind: "LShape",
      min: 0,
      max: 1,
    },
    decay: {
      type: "knob",
      col: 2,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Decay",
      bind: "Decay",
      min: 0,
      max: 1,
    },
    distance: {
      type: "knob",
      col: 0,
      row: 4,
      colSpan: 2,
      rowSpan: 2,
      label: "Dist",
      bind: "Distnc",
      min: 0,
      max: 1,
    },
  },
})
