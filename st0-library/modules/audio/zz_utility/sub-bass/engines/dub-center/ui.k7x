// dub-center — Airwindows Dub Center, a grind stage then bass and sub-bass generators
cols(18)
rows(2)
widgets({
  grind: {
    type: "group",
    col: 0,
    row: 0,
    colSpan: 4,
    rowSpan: 2,
    label: "GRIND",
    color: "#ff6a1a26",
  },
  grind_amt: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Grind",
    bind: "TGrind",
    min: 0,
    max: 1,
  },
  grind_out: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "GrdOut",
    bind: "Grd/Out",
    min: 0,
    max: 1,
  },
  xover: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "XOver",
    bind: "XOver",
    min: 0,
    max: 1,
  },
  bass: { type: "group", col: 6, row: 0, colSpan: 6, rowSpan: 2, label: "BASS", color: "#3d7dff26" },
  bass_drive: {
    type: "knob",
    col: 6,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Drive",
    bind: "BsDrive",
    min: 0,
    max: 1,
  },
  bass_voice: {
    type: "knob",
    col: 8,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Voice",
    bind: "BsVoice",
    min: 0,
    max: 1,
  },
  bass_out: {
    type: "knob",
    col: 10,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Level",
    bind: "BassOut",
    min: 0,
    max: 1,
  },
  sub: { type: "group", col: 12, row: 0, colSpan: 6, rowSpan: 2, label: "SUB", color: "#3d7dff26" },
  sub_drive: {
    type: "knob",
    col: 12,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Drive",
    bind: "SbDrive",
    min: 0,
    max: 1,
  },
  sub_voice: {
    type: "knob",
    col: 14,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Voice",
    bind: "SbVoice",
    min: 0,
    max: 1,
  },
  sub_out: {
    type: "knob",
    col: 16,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Level",
    bind: "SubOut",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 12,
  widgets: {
    grind: {
