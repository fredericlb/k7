// bass-kit — Airwindows BassKit, a bass and sub-octave generator
cols(8)
rows(2)
widgets({
  gen: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "GEN", color: "#ffffff14" },
  drive: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Drive",
    bind: "Drive",
    min: 0,
    max: 1,
  },
  voicing: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Voice",
    bind: "Voicing",
    min: 0,
    max: 1,
  },
  layers: {
    type: "group",
    col: 4,
    row: 0,
    colSpan: 4,
    rowSpan: 2,
    label: "MIX",
    color: "#3d7dff26",
  },
  bass: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Bass",
    bind: "BassOut",
    min: 0,
    max: 1,
  },
  sub: {
    type: "knob",
    col: 6,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Sub",
    bind: "SubOut",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    gen: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "GEN", color: "#ffffff14" },
    drive: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Drive",
      bind: "Drive",
      min: 0,
      max: 1,
    },
    voicing: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Voice",
      bind: "Voicing",
      min: 0,
      max: 1,
    },
    layers: {
      type: "group",
      col: 0,
      row: 2,
      colSpan: 4,
      rowSpan: 2,
      label: "MIX",
      color: "#3d7dff26",
    },
    bass: {
      type: "knob",
      col: 0,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Bass",
      bind: "BassOut",
      min: 0,
      max: 1,
    },
    sub: {
      type: "knob",
      col: 2,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Sub",
      bind: "SubOut",
      min: 0,
      max: 1,
    },
  },
})
