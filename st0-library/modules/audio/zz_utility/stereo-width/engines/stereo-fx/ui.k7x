// stereo-fx — a stereo widener with mono bass
cols(6)
rows(2)
widgets({
  wide: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Wide", bind: "Wide", min: 0, max: 1 },
  mono_bass: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Mono Bs", bind: "MonoBs", min: 0, max: 1 },
  squish: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Squish", bind: "CSquish", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    wide: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Wide", bind: "Wide", min: 0, max: 1 },
    mono_bass: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Mono Bs", bind: "MonoBs", min: 0, max: 1 },
    squish: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Squish", bind: "CSquish", min: 0, max: 1 },
  },
})
