// vibrato — a pitch vibrato whose own speed can be swept by a second LFO
cols(8)
rows(2)
widgets({
  vib_section: {
    type: "group",
    col: 0,
    row: 0,
    colSpan: 4,
    rowSpan: 2,
    label: "VIB",
    color: "#3d7dff26",
  },
  speed: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Speed",
    bind: "Speed",
    min: 0,
    max: 1,
  },
  depth: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Depth",
    bind: "Depth",
    min: 0,
    max: 1,
  },
  fm_section: {
    type: "group",
    col: 4,
    row: 0,
    colSpan: 4,
    rowSpan: 2,
    label: "FM",
    color: "#3d7dff26",
  },
  fm_speed: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "FM Spd",
    bind: "FMSpeed",
    min: 0,
    max: 1,
  },
  fm_depth: {
    type: "knob",
    col: 6,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "FM Dep",
    bind: "FMDepth",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    vib_section: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 4,
      rowSpan: 2,
      label: "VIB",
      color: "#3d7dff26",
    },
    speed: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Speed",
      bind: "Speed",
      min: 0,
      max: 1,
    },
    depth: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Depth",
      bind: "Depth",
      min: 0,
      max: 1,
    },
    fm_section: {
      type: "group",
      col: 0,
      row: 2,
      colSpan: 4,
      rowSpan: 2,
      label: "FM",
      color: "#3d7dff26",
    },
    fm_speed: {
      type: "knob",
      col: 0,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "FM Spd",
      bind: "FMSpeed",
      min: 0,
      max: 1,
    },
    fm_depth: {
      type: "knob",
      col: 2,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "FM Dep",
      bind: "FMDepth",
      min: 0,
      max: 1,
    },
  },
})
