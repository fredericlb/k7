// auto-wah — a touch wah, a resonant band pass swept by the playing level
cols(10)
rows(4)
widgets({
  filter: {
    type: "group",
    col: 0,
    row: 0,
    colSpan: 4,
    rowSpan: 4,
    label: "FILTER",
    color: "#3d7dff26",
  },
  low: {
    type: "fader",
    col: 0,
    row: 0,
    rowSpan: 4,
    label: "Low",
    bind: "Low",
    min: 60,
    max: 8000,
    curve: "log",
  },
  high: {
    type: "fader",
    col: 1,
    row: 0,
    rowSpan: 4,
    label: "High",
    bind: "High",
    min: 60,
    max: 8000,
    curve: "log",
  },
  res: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Res",
    bind: "Resonance",
    min: 0.5,
    max: 20,
    curve: "log",
  },
  down: { type: "toggle", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Down", bind: "Direction" },
  env: { type: "group", col: 4, row: 0, colSpan: 6, rowSpan: 2, label: "ENV", color: "#3ec96b26" },
  sens: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Sens",
    bind: "Sensitivity",
    min: 0,
    max: 1,
  },
  attack: {
    type: "knob",
    col: 6,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Attack",
    bind: "Attack",
    min: 0.1,
    max: 200,
    curve: "log",
  },
  release: {
    type: "knob",
    col: 8,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Release",
    bind: "Release",
    min: 1,
    max: 1000,
    curve: "log",
  },
  sweep: { type: "lcdscreen", col: 4, row: 2, colSpan: 6, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 10,
  widgets: {
    filter: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 4,
      rowSpan: 4,
      label: "FILTER",
      color: "#3d7dff26",
    },
    low: {
      type: "fader",
      col: 0,
      row: 0,
      rowSpan: 4,
      label: "Low",
      bind: "Low",
      min: 60,
      max: 8000,
      curve: "log",
    },
    high: {
      type: "fader",
      col: 1,
      row: 0,
      rowSpan: 4,
      label: "High",
      bind: "High",
      min: 60,
      max: 8000,
      curve: "log",
    },
    res: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Res",
      bind: "Resonance",
      min: 0.5,
      max: 20,
      curve: "log",
    },
    down: {
      type: "toggle",
      col: 2,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Down",
      bind: "Direction",
    },
    env: { type: "group", col: 0, row: 4, colSpan: 4, rowSpan: 4, label: "ENV", color: "#3ec96b26" },
    sens: {
      type: "knob",
      col: 0,
      row: 4,
      colSpan: 2,
      rowSpan: 2,
      label: "Sens",
      bind: "Sensitivity",
      min: 0,
      max: 1,
    },
    attack: {
      type: "knob",
      col: 2,
      row: 4,
      colSpan: 2,
      rowSpan: 2,
      label: "Attack",
      bind: "Attack",
      min: 0.1,
      max: 200,
      curve: "log",
    },
    release: {
      type: "knob",
      col: 0,
      row: 6,
      colSpan: 2,
      rowSpan: 2,
      label: "Release",
      bind: "Release",
      min: 1,
      max: 1000,
      curve: "log",
    },
    sweep: { type: "lcdscreen", col: 0, row: 8, colSpan: 4, rowSpan: 2 },
  },
})
