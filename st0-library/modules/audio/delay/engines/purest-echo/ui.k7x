// purest-echo — a four-tap echo
cols(8)
rows(4)
widgets({
  time: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Time", bind: "Time", min: 0, max: 1 },
  taps: { type: "group", col: 0, row: 2, colSpan: 8, rowSpan: 2, label: "TAPS", color: "#3d7dff26" },
  tap1: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Tap 1", bind: "Tap 1", min: 0, max: 1 },
  tap2: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Tap 2", bind: "Tap 2", min: 0, max: 1 },
  tap3: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Tap 3", bind: "Tap 3", min: 0, max: 1 },
  tap4: { type: "knob", col: 6, row: 2, colSpan: 2, rowSpan: 2, label: "Tap 4", bind: "Tap 4", min: 0, max: 1 },
  taps_screen: { type: "lcdscreen", col: 4, row: 0, colSpan: 4, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 8,
  widgets: {
    time: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Time", bind: "Time", min: 0, max: 1 },
    taps_screen: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 2 },
    taps: { type: "group", col: 0, row: 4, colSpan: 4, rowSpan: 4, label: "TAPS", color: "#3d7dff26" },
    tap1: { type: "knob", col: 0, row: 4, colSpan: 2, rowSpan: 2, label: "Tap 1", bind: "Tap 1", min: 0, max: 1 },
    tap2: { type: "knob", col: 2, row: 4, colSpan: 2, rowSpan: 2, label: "Tap 2", bind: "Tap 2", min: 0, max: 1 },
    tap3: { type: "knob", col: 0, row: 6, colSpan: 2, rowSpan: 2, label: "Tap 3", bind: "Tap 3", min: 0, max: 1 },
    tap4: { type: "knob", col: 2, row: 6, colSpan: 2, rowSpan: 2, label: "Tap 4", bind: "Tap 4", min: 0, max: 1 },
  },
})
