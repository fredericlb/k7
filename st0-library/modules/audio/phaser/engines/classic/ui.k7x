// phaser-classic — Tracktion's phaser as a graph, a swept all-pass with feedback whose knobs automate
cols(6)
rows(2)
widgets({
  phase_section: {
    type: "group",
    col: 0,
    row: 0,
    colSpan: 6,
    rowSpan: 2,
    label: "PHASE",
    color: "#3d7dff26",
  },
  rate: {
    type: "knob",
    col: 0,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Rate",
    bind: "Rate",
    min: 0,
    max: 10,
  },
  depth: {
    type: "knob",
    col: 2,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Depth",
    bind: "Depth",
    min: 0,
    max: 10,
  },
  feedback: {
    type: "knob",
    col: 4,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Fdbk",
    bind: "Feedback",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    phase_section: {
      type: "group",
      col: 0,
      row: 0,
      colSpan: 4,
      rowSpan: 4,
      label: "PHASE",
      color: "#3d7dff26",
    },
    rate: {
      type: "knob",
      col: 0,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Rate",
      bind: "Rate",
      min: 0,
      max: 10,
    },
    depth: {
      type: "knob",
      col: 2,
      row: 0,
      colSpan: 2,
      rowSpan: 2,
      label: "Depth",
      bind: "Depth",
      min: 0,
      max: 10,
    },
    feedback: {
      type: "knob",
      col: 0,
      row: 2,
      colSpan: 2,
      rowSpan: 2,
      label: "Fdbk",
      bind: "Feedback",
      min: 0,
      max: 1,
    },
  },
})
