// desk-4 — analog desk saturation with power sag
cols(8)
rows(4)
widgets({
  level_screen: { type: "lcdscreen", col: 0, row: 0, colSpan: 8, rowSpan: 2 },
  drive_grp: {
    type: "group",
    col: 0,
    row: 2,
    colSpan: 4,
    rowSpan: 2,
    label: "DRIVE",
    color: "#ff6a1a26",
  },
  overdrive: {
    type: "knob",
    col: 0,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Drive",
    bind: "Overdrive",
    min: 0,
    max: 1,
  },
  hi_choke: {
    type: "knob",
    col: 2,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "HiChoke",
    bind: "Hi Choke",
    min: 0,
    max: 1,
  },
  sag_grp: {
    type: "group",
    col: 4,
    row: 2,
    colSpan: 4,
    rowSpan: 2,
    label: "SAG",
    color: "#ff3b3026",
  },
  power_sag: {
    type: "knob",
    col: 4,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Sag",
    bind: "Power Sag",
    min: 0,
    max: 1,
  },
  frequency: {
    type: "knob",
    col: 6,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Freq",
    bind: "Frequency",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 7,
  widgets: {
    level_screen: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 3 },
    drive_grp: {
      type: "group",
      col: 0,
      row: 3,
      colSpan: 4,
      rowSpan: 2,
      label: "DRIVE",
      color: "#ff6a1a26",
    },
    overdrive: {
      type: "knob",
      col: 0,
      row: 3,
      colSpan: 2,
      rowSpan: 2,
      label: "Drive",
      bind: "Overdrive",
      min: 0,
      max: 1,
    },
    hi_choke: {
      type: "knob",
      col: 2,
      row: 3,
      colSpan: 2,
      rowSpan: 2,
      label: "HiChoke",
      bind: "Hi Choke",
      min: 0,
      max: 1,
    },
    sag_grp: {
      type: "group",
      col: 0,
      row: 5,
      colSpan: 4,
      rowSpan: 2,
      label: "SAG",
      color: "#ff3b3026",
    },
    power_sag: {
      type: "knob",
      col: 0,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Sag",
      bind: "Power Sag",
      min: 0,
      max: 1,
    },
    frequency: {
      type: "knob",
      col: 2,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Freq",
      bind: "Frequency",
      min: 0,
      max: 1,
    },
  },
})
