// tremolo — the level rising and falling with a sine LFO
cols(8)
rows(2)
widgets({
  trem_section: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "TREM", color: "#3d7dff26" },
  rate: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Rate", bind: "Rate", min: 0.1, max: 20, curve: "log" },
  depth: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Depth", bind: "Depth", min: 0, max: 1 },
  gain: { type: "lcdscreen", col: 4, row: 0, colSpan: 4, rowSpan: 2 },
})
vertical({
  cols: 4,
  rows: 4,
  widgets: {
    trem_section: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 2, label: "TREM", color: "#3d7dff26" },
    rate: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Rate", bind: "Rate", min: 0.1, max: 20, curve: "log" },
    depth: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Depth", bind: "Depth", min: 0, max: 1 },
    gain: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 2 },
  },
})
