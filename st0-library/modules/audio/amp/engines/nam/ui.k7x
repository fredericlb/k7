// neural-amp-modeler — the model and its cabinet, the model's own knobs when it has any, the level in against the level out
// widgets.js shows the knobs the loaded model was trained with.
cols(12)
rows(4)
widgets({
  model: { type: "filepicker", col: 0, row: 0, colSpan: 5, label: "Model", bind: "model" },
  cabinet: { type: "filepicker", col: 5, row: 0, colSpan: 5, label: "Cabinet", bind: "ir" },
  norm: { type: "toggle", col: 10, row: 0, colSpan: 2, label: "Normalize", bind: "Normalize" },
  knobs: { type: "group", col: 0, row: 1, colSpan: 6, rowSpan: 2, label: "AMP", color: "#ff6a1a26" },
  knob_1: {
    type: "knob",
    col: 0,
    row: 1,
    colSpan: 2,
    rowSpan: 2,
    label: "Knob 1",
    bind: "Knob 1",
    min: 0,
    max: 1,
  },
  knob_2: {
    type: "knob",
    col: 2,
    row: 1,
    colSpan: 2,
    rowSpan: 2,
    label: "Knob 2",
    bind: "Knob 2",
    min: 0,
    max: 1,
  },
  knob_3: {
    type: "knob",
    col: 4,
    row: 1,
    colSpan: 2,
    rowSpan: 2,
    label: "Knob 3",
    bind: "Knob 3",
    min: 0,
    max: 1,
  },
  screen: { type: "lcdscreen", col: 6, row: 1, colSpan: 6, rowSpan: 3 },
})
vertical({
  cols: 4,
  rows: 10,
  widgets: {
    model: { type: "filepicker", col: 0, row: 0, colSpan: 4, label: "Model", bind: "model" },
    cabinet: { type: "filepicker", col: 0, row: 1, colSpan: 4, label: "Cabinet", bind: "ir" },
    norm: { type: "toggle", col: 0, row: 2, colSpan: 2, label: "Normalize", bind: "Normalize" },
    knobs: {
      type: "group",
      col: 0,
      row: 3,
      colSpan: 4,
      rowSpan: 4,
      label: "AMP",
      color: "#ff6a1a26",
    },
    knob_1: {
      type: "knob",
      col: 0,
      row: 3,
      colSpan: 2,
      rowSpan: 2,
      label: "Knob 1",
      bind: "Knob 1",
      min: 0,
      max: 1,
    },
    knob_2: {
      type: "knob",
      col: 2,
      row: 3,
      colSpan: 2,
      rowSpan: 2,
      label: "Knob 2",
      bind: "Knob 2",
      min: 0,
      max: 1,
    },
    knob_3: {
      type: "knob",
      col: 0,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Knob 3",
      bind: "Knob 3",
      min: 0,
      max: 1,
    },
    screen: { type: "lcdscreen", col: 0, row: 7, colSpan: 4, rowSpan: 3 },
  },
})
