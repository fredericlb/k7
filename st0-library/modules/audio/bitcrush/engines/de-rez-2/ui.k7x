// de-rez-2 — Airwindows DeRez2, sample-rate and bit-depth reduction
cols(9)
rows(2)
widgets({
  rez_screen: { type: "lcdscreen", col: 0, row: 0, colSpan: 3, rowSpan: 2 },
  crush: { type: "group", col: 3, row: 0, colSpan: 6, rowSpan: 2, label: "CRUSH", color: "#ff6a1a22" },
  rate: { type: "knob", col: 3, row: 0, colSpan: 2, rowSpan: 2, label: "Rate", bind: "Rate", min: 0, max: 1 },
  rez: { type: "knob", col: 5, row: 0, colSpan: 2, rowSpan: 2, label: "Rez", bind: "Rez", min: 0, max: 1 },
  hard: { type: "knob", col: 7, row: 0, colSpan: 2, rowSpan: 2, label: "Hard", bind: "Hard", min: 0, max: 1 },
})
vertical({
  cols: 4,
  rows: 6,
  widgets: {
    rez_screen: { type: "lcdscreen", col: 0, row: 0, colSpan: 4, rowSpan: 2 },
    crush: { type: "group", col: 0, row: 2, colSpan: 4, rowSpan: 4, label: "CRUSH", color: "#ff6a1a22" },
    rate: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Rate", bind: "Rate", min: 0, max: 1 },
    rez: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Rez", bind: "Rez", min: 0, max: 1 },
    hard: { type: "knob", col: 0, row: 4, colSpan: 2, rowSpan: 2, label: "Hard", bind: "Hard", min: 0, max: 1 },
  },
})
