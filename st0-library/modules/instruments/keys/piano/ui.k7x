// panel for @st0/instruments/keys/piano
//
// One knob: the instrument's level. Everything else a piano has — the hammers, the strings, the room — is
// in the samples, which is the point of a sampled one. The credit line is the licence's, not decoration.
cols(4)
rows(2)
widgets({
  volume: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Volume", bind: "Volume", min: -40, max: 12 },
  credit: { type: "label", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Salamander Grand Piano · A. Holm · CC BY 3.0" },
})
