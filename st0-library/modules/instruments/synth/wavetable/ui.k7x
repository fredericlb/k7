// wavetable — the table and where in it the note reads, drawn; the filter, the glide and the envelope
cols(16)
rows(4)
widgets({
  osc: { type: "group", col: 0, row: 0, colSpan: 8, rowSpan: 4, label: "OSC", color: "#3d7dff26" },
  table: {
    type: "dropdown",
    col: 0,
    row: 0,
    colSpan: 8,
    label: "Table",
    bind: "Table",
    library: "wavetables",
  },
  wave: { type: "lcdscreen", col: 0, row: 1, colSpan: 6, rowSpan: 3 },
  position: {
    type: "knob",
    col: 6,
    row: 1,
    colSpan: 2,
    rowSpan: 2,
    label: "Position",
    bind: "Position",
    min: 0,
    max: 1,
  },
  tone: { type: "group", col: 8, row: 0, colSpan: 4, rowSpan: 4, label: "TONE", color: "#ff6a1a26" },
  cutoff: {
    type: "knob",
    col: 8,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Cutoff",
    bind: "Cutoff",
    min: 40,
    max: 20000,
  },
  resonance: {
    type: "knob",
    col: 10,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Reso",
    bind: "Resonance",
    min: 0.5,
    max: 10,
  },
  glide: {
    type: "knob",
    col: 8,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Glide",
    bind: "Glide",
    min: 0,
    max: 2,
  },
  env: {
    type: "group",
    col: 12,
    row: 0,
    colSpan: 4,
    rowSpan: 4,
    label: "ENVELOPE",
    color: "#22c55e26",
  },
  attack: {
    type: "knob",
    col: 12,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "A",
    bind: "Attack",
    min: 0.001,
    max: 4,
  },
  decay: {
    type: "knob",
    col: 14,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "D",
    bind: "Decay",
    min: 0.001,
    max: 4,
  },
  sustain: {
    type: "knob",
    col: 12,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "S",
    bind: "Sustain",
    min: 0,
    max: 1,
  },
  release: {
    type: "knob",
    col: 14,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "R",
    bind: "Release",
    min: 0.001,
    max: 8,
  },
})
vertical({
  cols: 4,
  rows: 13,
  widgets: {
    osc: { type: "group", col: 0, row: 0, colSpan: 4, rowSpan: 5, label: "OSC", color: "#3d7dff26" },
    table: {
      type: "dropdown",
      col: 0,
      row: 0,
      colSpan: 4,
      label: "Table",
      bind: "Table",
      library: "wavetables",
    },
    wave: { type: "lcdscreen", col: 0, row: 1, colSpan: 4, rowSpan: 2 },
    position: {
      type: "knob",
      col: 0,
      row: 3,
      colSpan: 2,
      rowSpan: 2,
      label: "Position",
      bind: "Position",
      min: 0,
      max: 1,
    },
    tone: {
      type: "group",
      col: 0,
      row: 5,
      colSpan: 4,
      rowSpan: 4,
      label: "TONE",
      color: "#ff6a1a26",
    },
    cutoff: {
      type: "knob",
      col: 0,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Cutoff",
      bind: "Cutoff",
      min: 40,
      max: 20000,
    },
    resonance: {
      type: "knob",
      col: 2,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Reso",
      bind: "Resonance",
      min: 0.5,
      max: 10,
    },
    glide: {
      type: "knob",
      col: 0,
      row: 7,
      colSpan: 2,
      rowSpan: 2,
      label: "Glide",
      bind: "Glide",
      min: 0,
      max: 2,
    },
    env: {
      type: "group",
      col: 0,
      row: 9,
      colSpan: 4,
      rowSpan: 4,
      label: "ENVELOPE",
      color: "#22c55e26",
    },
    attack: {
      type: "knob",
      col: 0,
      row: 9,
      colSpan: 2,
      rowSpan: 2,
      label: "A",
      bind: "Attack",
      min: 0.001,
      max: 4,
    },
    decay: {
      type: "knob",
      col: 2,
      row: 9,
      colSpan: 2,
      rowSpan: 2,
      label: "D",
      bind: "Decay",
      min: 0.001,
      max: 4,
    },
    sustain: {
      type: "knob",
      col: 0,
      row: 11,
      colSpan: 2,
      rowSpan: 2,
      label: "S",
      bind: "Sustain",
      min: 0,
      max: 1,
    },
    release: {
      type: "knob",
      col: 2,
      row: 11,
      colSpan: 2,
      rowSpan: 2,
      label: "R",
      bind: "Release",
      min: 0.001,
      max: 8,
    },
  },
})
