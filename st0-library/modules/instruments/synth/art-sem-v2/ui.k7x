// sem-v2 — SEM V2: two VCOs and a sub into the morphing state-variable VCF, two ADS envelopes, two LFOs.
cols(16)
rows(4)
widgets({})
tabs([
  name("VOICE")
    .widgets({
      vco: { type: "group", col: 0, row: 0, colSpan: 6, rowSpan: 4, label: "VCO", color: "#3d7dff26" },
      tune1: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Tune 1", bind: "VCO1 Freq (fine)", min: 0, max: 1 },
      pw1: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "PW 1", bind: "VCO1 PW", min: 0, max: 1 },
      mod1: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Mod 1", bind: "VCO1 Modulation Amount", min: 0, max: 1 },
      tune2: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Tune 2", bind: "VCO2 Freq (fine)", min: 0, max: 1 },
      pw2: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "PW 2", bind: "VCO2 PW", min: 0, max: 1 },
      mod2: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Mod 2", bind: "VCO2 Modulation Amount", min: 0, max: 1 },
      mixer: { type: "group", col: 6, row: 0, colSpan: 4, rowSpan: 4, label: "MIX", color: "#ffffff14" },
      lvl1: { type: "knob", col: 6, row: 0, colSpan: 2, rowSpan: 2, label: "VCO 1", bind: "VCO1 Mix", min: 0, max: 1 },
      lvl2: { type: "knob", col: 8, row: 0, colSpan: 2, rowSpan: 2, label: "VCO 2", bind: "VCO2 Mix", min: 0, max: 1 },
      sub: { type: "knob", col: 6, row: 2, colSpan: 2, rowSpan: 2, label: "Sub/Nz", bind: "SubOsc/Noise Mix", min: 0, max: 1 },
      sync: { type: "toggle", col: 8, row: 2, colSpan: 2, label: "Sync", bind: "VCO Hard Sync" },
      sub_wave: { type: "dropdown", col: 8, row: 3, colSpan: 2, bind: "SubOsc Waveshape", options: [label("SIN").value(0), label("SAW").value(0.5), label("SQR").value(1)] },
      vcf: { type: "group", col: 10, row: 0, colSpan: 6, rowSpan: 4, label: "VCF", color: "#ff6a1a26" },
      vcf_screen: { type: "lcdscreen", col: 10, row: 0, colSpan: 4, rowSpan: 2 },
      vcf_mode: { type: "knob", col: 14, row: 0, colSpan: 2, rowSpan: 2, label: "Mode", bind: "VCF Mode", min: 0, max: 1 },
      cutoff: { type: "knob", col: 10, row: 2, colSpan: 2, rowSpan: 2, label: "Cutoff", bind: "VCF Freq", min: 0, max: 1 },
      res: { type: "knob", col: 12, row: 2, colSpan: 2, rowSpan: 2, label: "Res", bind: "VCF Res", min: 0, max: 1 },
      vcf_mod: { type: "knob", col: 14, row: 2, colSpan: 2, rowSpan: 2, label: "Mod", bind: "VCF Modulation Amount", min: 0, max: 1 },
    }),
  name("MOD")
    .widgets({
      env: { type: "group", col: 0, row: 0, colSpan: 10, rowSpan: 4, label: "ENV", color: "#3ec96b26" },
      atk1: { type: "knob", col: 0, row: 0, colSpan: 2, rowSpan: 2, label: "Attack 1", bind: "ENV1 Attack", min: 0, max: 1 },
      dec1: { type: "knob", col: 2, row: 0, colSpan: 2, rowSpan: 2, label: "Decay 1", bind: "ENV1 Decay", min: 0, max: 1 },
      sus1: { type: "knob", col: 4, row: 0, colSpan: 2, rowSpan: 2, label: "Sus 1", bind: "ENV1 Sustain", min: 0, max: 1 },
      atk2: { type: "knob", col: 0, row: 2, colSpan: 2, rowSpan: 2, label: "Attack 2", bind: "ENV2 Attack", min: 0, max: 1 },
      dec2: { type: "knob", col: 2, row: 2, colSpan: 2, rowSpan: 2, label: "Decay 2", bind: "ENV2 Decay", min: 0, max: 1 },
      sus2: { type: "knob", col: 4, row: 2, colSpan: 2, rowSpan: 2, label: "Sus 2", bind: "ENV2 Sustain", min: 0, max: 1 },
      env_screen: { type: "lcdscreen", col: 6, row: 0, colSpan: 4, rowSpan: 4 },
      lfo: { type: "group", col: 10, row: 0, colSpan: 4, rowSpan: 4, label: "LFO", color: "#6b6b6b33" },
      lfo1: { type: "knob", col: 10, row: 0, colSpan: 2, rowSpan: 2, label: "LFO 1", bind: "LFO1 Freq", min: 0, max: 1 },
      lfo2: { type: "knob", col: 12, row: 0, colSpan: 2, rowSpan: 2, label: "LFO 2", bind: "LFO2 Freq", min: 0, max: 1 },
      fade: { type: "knob", col: 10, row: 2, colSpan: 2, rowSpan: 2, label: "Fade", bind: "LFO2 Fade In", min: 0, max: 1 },
      lfo2_wave: { type: "dropdown", col: 12, row: 2, colSpan: 2, bind: "LFO2 Waveshape", options: [label("SIN").value(0), label("SAW").value(0.5), label("SQR").value(1)] },
      vcf_src: { type: "dropdown", col: 12, row: 3, colSpan: 2, bind: "VCF Modulation Source", options: [label("ENV2").value(0), label("LFO1").value(0.5), label("LFO2").value(1)] },
      out: { type: "group", col: 14, row: 0, colSpan: 2, rowSpan: 4, label: "OUT", color: "#ff3b3026" },
      glide: { type: "knob", col: 14, row: 0, colSpan: 2, rowSpan: 2, label: "Glide", bind: "Portamento Time", min: 0, max: 1 },
      drive: { type: "knob", col: 14, row: 2, colSpan: 2, rowSpan: 2, label: "Drive", bind: "Overdrive drive", min: 0, max: 1 },
    }),
])
