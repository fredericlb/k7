// mu-rings — the resonator: its model and exciter, the partials it rings on the screen, four knobs to shape them, then pitch
cols(17)
rows(4)
widgets({
  model: {
    type: "dropdown",
    col: 0,
    row: 0,
    colSpan: 5,
    label: "Model",
    bind: "Model",
    options: [
      label("Modal").value(0),
      label("Sympathetic strings").value(1),
      label("String").value(2),
      label("FM voice").value(3),
      label("Sympathetic quantized").value(4),
      label("String + reverb").value(5),
      label("Synth: formant").value(6),
      label("Synth: chorus").value(7),
      label("Synth: reverb").value(8),
      label("Synth: formant 2").value(9),
      label("Synth: ensemble").value(10),
      label("Synth: reverb 2").value(11),
    ],
  },
  polyphony: {
    type: "dropdown",
    col: 0,
    row: 1,
    colSpan: 5,
    label: "Poly",
    bind: "Polyphony",
    options: [label("1").value(0), label("2").value(1), label("4").value(2)],
  },
  exciter: {
    type: "dropdown",
    col: 0,
    row: 2,
    colSpan: 5,
    label: "Exciter",
    bind: "Exciter",
    options: [label("internal").value(0), label("input only").value(1)],
  },
  partials: { type: "lcdscreen", col: 5, row: 0, colSpan: 6, rowSpan: 4 },
  resonator: {
    type: "group",
    col: 11,
    row: 0,
    colSpan: 4,
    rowSpan: 4,
    label: "RES",
    color: "#3ec96b26",
  },
  structure: {
    type: "knob",
    col: 11,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Struct",
    bind: "Structure",
    min: 0,
    max: 1,
  },
  brightness: {
    type: "knob",
    col: 13,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Bright",
    bind: "Brightness",
    min: 0,
    max: 1,
  },
  damping: {
    type: "knob",
    col: 11,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Damp",
    bind: "Damping",
    min: 0,
    max: 1,
  },
  position: {
    type: "knob",
    col: 13,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Pos",
    bind: "Position",
    min: 0,
    max: 1,
  },
  pitch: {
    type: "group",
    col: 15,
    row: 0,
    colSpan: 2,
    rowSpan: 4,
    label: "PITCH",
    color: "#6b6b6b33",
  },
  transpose: {
    type: "knob",
    col: 15,
    row: 0,
    colSpan: 2,
    rowSpan: 2,
    label: "Transp",
    bind: "Transpose",
    min: -24,
    max: 24,
    step: 1,
  },
  glide: {
    type: "knob",
    col: 15,
    row: 2,
    colSpan: 2,
    rowSpan: 2,
    label: "Glide",
    bind: "Glide",
    min: 0,
    max: 1,
  },
})
vertical({
  cols: 4,
  rows: 11,
  widgets: {
    model: {
      type: "dropdown",
      col: 0,
      row: 0,
      colSpan: 4,
      label: "Model",
      bind: "Model",
      options: [
        label("Modal").value(0),
        label("Sympathetic strings").value(1),
        label("String").value(2),
        label("FM voice").value(3),
        label("Sympathetic quantized").value(4),
        label("String + reverb").value(5),
        label("Synth: formant").value(6),
        label("Synth: chorus").value(7),
        label("Synth: reverb").value(8),
        label("Synth: formant 2").value(9),
        label("Synth: ensemble").value(10),
        label("Synth: reverb 2").value(11),
      ],
    },
    polyphony: {
      type: "dropdown",
      col: 0,
      row: 1,
      colSpan: 2,
      label: "Poly",
      bind: "Polyphony",
      options: [label("1").value(0), label("2").value(1), label("4").value(2)],
    },
    exciter: {
      type: "dropdown",
      col: 2,
      row: 1,
      colSpan: 2,
      label: "Exciter",
      bind: "Exciter",
      options: [label("internal").value(0), label("input only").value(1)],
    },
    partials: { type: "lcdscreen", col: 0, row: 2, colSpan: 4, rowSpan: 3 },
    resonator: {
      type: "group",
      col: 0,
      row: 5,
      colSpan: 4,
      rowSpan: 4,
      label: "RES",
      color: "#3ec96b26",
    },
    structure: {
      type: "knob",
      col: 0,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Struct",
      bind: "Structure",
      min: 0,
      max: 1,
    },
    brightness: {
      type: "knob",
      col: 2,
      row: 5,
      colSpan: 2,
      rowSpan: 2,
      label: "Bright",
      bind: "Brightness",
      min: 0,
      max: 1,
    },
    damping: {
      type: "knob",
      col: 0,
      row: 7,
      colSpan: 2,
      rowSpan: 2,
      label: "Damp",
      bind: "Damping",
      min: 0,
      max: 1,
    },
    position: {
      type: "knob",
      col: 2,
      row: 7,
      colSpan: 2,
      rowSpan: 2,
      label: "Pos",
      bind: "Position",
      min: 0,
      max: 1,
    },
    pitch: {
      type: "group",
      col: 0,
      row: 9,
      colSpan: 4,
      rowSpan: 2,
      label: "PITCH",
      color: "#6b6b6b33",
    },
    transpose: {
      type: "knob",
      col: 0,
      row: 9,
      colSpan: 2,
      rowSpan: 2,
      label: "Transp",
      bind: "Transpose",
      min: -24,
      max: 24,
      step: 1,
    },
    glide: {
      type: "knob",
      col: 2,
      row: 9,
      colSpan: 2,
      rowSpan: 2,
      label: "Glide",
      bind: "Glide",
      min: 0,
      max: 1,
    },
  },
})
