// The three-band channel EQ. Flat, and only the three gains are stated: the crossover points come
// from the module, and restating them would let one deck disagree with the other about "mid".
extends("@st0/audio/eq")
engine("tracktion")
engines({ tracktion: { params: { "Low-shelf gain": 0, "Mid gain 1": 0, "High-shelf gain": 0 } } })
