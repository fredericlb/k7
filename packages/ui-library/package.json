    "@studio/song-schema": "*",
    "@studio/ui-editor": "*",
    "@studio/ui-mini-player": "*",
    "@studio/ui-waveform": "*",
    "@studio/web-protocol": "*",
    "music-metadata": "^11.14.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
