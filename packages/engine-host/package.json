{
  "name": "@studio/engine-host",
  "version": "0.0.1",
  "bin": {
    "studio-engine": "./src/cli.ts"
  },
  "private": true,
  "type": "module",
  "description": "st0's engine supervisor — owns the engine's identity, the ~/.st0 contract, the registry heartbeat and the web-UI allowlist. Two front ends over one startSupervisor: the desktop app, which EMBEDS it in its main process, and src/cli.ts (`studio-engine`) for a terminal. Consumed as source.",
  "exports": {
    "./identity": "./src/identity.ts",
    "./addresses": "./src/addresses.ts",
    "./settings": "./src/settings.ts",
    "./hostProtocol": "./src/hostProtocol.ts",
    "./supervisor": "./src/supervisor.ts",
    "./webOrigins": "./src/webOrigins.ts",
    "./audioPolicy": "./src/audioPolicy.ts",
    "./logbus": "./src/logbus.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx --use-system-ca src/cli.ts",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/engine-client": "*",
    "@studio/web-protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.5.0"
  }
}
