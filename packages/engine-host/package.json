{
  "name": "@studio/engine-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "lanes's engine supervisor \u2014 owns the engine's identity, the ~/.lanes contract, the registry heartbeat and the web-UI allowlist. Spawned by engine-tray (the menu-bar view) and driven over NDJSON on stdio; not a standalone CLI. Consumed as source.",
  "exports": {
    "./identity": "./src/identity.ts",
    "./addresses": "./src/addresses.ts",
    "./settings": "./src/settings.ts",
    "./hostProtocol": "./src/hostProtocol.ts",
    "./webOrigins": "./src/webOrigins.ts",
    "./audioPolicy": "./src/audioPolicy.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/engine-client": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
