{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Consumed as source, and its own imports carry the `.ts` extension.
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // Sources sit at the package root here, not under `src`.
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
