    "./basePreset": "./src/basePreset.ts",
    "./alternatives": "./src/alternatives.ts",
    "./freeze": "./src/freeze.ts",
    "./autoFreeze": "./src/autoFreeze.ts",
    "./preferences": "./src/preferences.ts",
    "./curves": "./src/curves.ts",
    "./moduleFork": "./src/moduleFork.ts",
    "./uiLibrary": "./src/uiLibrary.ts",
    "./uiMigrate": "./src/uiMigrate.ts",
    "./chainsMigrate": "./src/chainsMigrate.ts",
    "./chainsGraph": "./src/chainsGraph.ts",
    "./controller": "./src/controller.ts",
    "./controllerBind": "./src/controllerBind.ts",
    "./moduleAssetChoices": "./src/moduleAssetChoices.ts",
    "./hints": "./src/hints.ts",
    "./ioPorts": "./src/ioPorts.ts",
    "./moduleCatalogue": "./src/moduleCatalogue.ts",
    "./moduleCache": "./src/moduleCache.ts",
    "./moduleResolve": "./src/moduleResolve.ts",
    "./trackMixerFile": "./src/trackMixerFile.ts",
    "./trackModule": "./src/trackModule.ts",
    "./scaffold": "./src/scaffold.ts",
    "./scaffoldNeeds": "./src/scaffoldNeeds.ts",
    "./sharedFolders": "./src/sharedFolders.ts",
    "./libraryChains": "./src/libraryChains.ts",
    "./graph": "./src/graph.ts",
    "./nodeProject": "./src/nodeProject.ts",
    "./enginePattern": "./src/enginePattern.ts",
    "./project": "./src/project.ts",
    "./testSupport": "./src/testSupport.ts",
    "./yaml/edit": "./src/yaml/edit.ts",
    "./yaml/moduleIO": "./src/yaml/moduleIO.ts",
    "./yaml/materialFile": "./src/yaml/materialFile.ts",
    "./folder": "./src/folder.ts",
    "./engineCatalogue": "./src/engineCatalogue.ts",
    "./engineFace": "./src/engineFace.ts",
    "./mediatekRoot": "./src/mediatekRoot.ts",
    "./studioHome": "./src/studioHome.ts",
    "./modelCache": "./src/modelCache.ts",
    "./mediatekRefs": "./src/mediatekRefs.ts",
    "./surfaces": "./src/surfaces.ts",
    "./assemblies": "./src/assemblies.ts",
    "./assemblyEdit": "./src/assemblyEdit.ts",
    "./scaffoldLive": "./src/scaffoldLive.ts",
    "./scaffoldSet": "./src/scaffoldSet.ts",
    "./videoOutputs": "./src/videoOutputs.ts",
    "./rawDoc": "./src/rawDoc.ts",
    "./libraryFiles": "./src/libraryFiles.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^4.4.3",
    "@studio/dsp": "*",
    "@studio/song-schema": "*",
    "@studio/engine-protocol": "*",
    "@studio/graph-model": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
