{
  "name": "@studio/song",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "l8's song layer — parses a folder of CUE files, compiles it to a flat ProjectDoc/GraphDoc, and resolves Strudel patterns. Consumed as source.",
