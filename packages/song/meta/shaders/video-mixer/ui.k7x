// video-mixer — the picture strip's four knobs: the three channels, then how transparent the lane is.
cols(4)
rows(1)
widgets({
  red: { type: "knob", col: 0, row: 0, label: "Red", bind: "P1", min: 0, max: 1, step: 0.01 },
  green: { type: "knob", col: 1, row: 0, label: "Green", bind: "P2", min: 0, max: 1, step: 0.01 },
  blue: { type: "knob", col: 2, row: 0, label: "Blue", bind: "P3", min: 0, max: 1, step: 0.01 },
  transparency: { type: "knob", col: 3, row: 0, label: "Transparency", bind: "P4", min: 0, max: 1, step: 0.01 },
})
