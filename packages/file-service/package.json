{
  "name": "@studio/file-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "k7's file service: one account's workspaces and every file operation on them, run on the SERVER by @studio/file-hub, one process per account, driving the engine the account claimed through its tunnel (the C++ engine stays file-free). Consumed as source; run under tsx.",
  "main": "src/server.ts",
  "bin": {
    "studio-file-service": "./src/server.ts"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@frediverse/http": "*",
    "@studio/audio-analysis": "*",
    "@studio/audio-passes": "*",
    "@studio/audio-probe": "*",
    "@studio/commands": "*",
    "@studio/engine-client": "*",
    "@studio/engine-tunnel": "*",
    "@studio/graph-model": "*",
    "@studio/live-sync": "*",
    "@studio/mediatek": "*",
    "@studio/song": "*",
    "@studio/song-edit": "*",
    "@studio/song-schema": "*",
    "@studio/song-video": "*",
    "@studio/k7-plugins": "*",
    "@studio/stem-separation": "*",
    "@studio/take-render": "*",
    "@studio/translator": "*",
    "@studio/ui-eyes": "*",
    "@studio/web-protocol": "*",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "playwright-core": "^1.64.1",
    "ws": "^8.18.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "fflate": "^0.8.2",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/ws": "^8.5.12"
  }
}
