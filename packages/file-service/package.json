{
  "name": "@studio/file-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "l8's engine-side file service. Runs on the engine's machine, owns ~/.studio/root/<userSlug>/<workspace>, and serves workspaces + all file operations to the browser directly (the C++ engine stays file-free). Consumed as source; run under tsx.",
  "main": "src/server.ts",
  "bin": {
    "studio-file-service": "./src/server.ts"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@studio/song": "*",
    "@studio/commands": "*",
    "@studio/engine-client": "*",
    "@studio/engine-host": "*",
    "@studio/translator": "*",
    "@frediverse/http": "*",
    "@studio/graph-model": "*",
    "@studio/mediatek": "*",
    "@studio/web-protocol": "*",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
