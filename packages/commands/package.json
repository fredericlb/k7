{
  "name": "@studio/commands",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "k7's shared command layer — the SID → handler mapping and the command specs, dispatched through by the CLI and the web alike. The work a verb does now lives beside it: @studio/song-edit changes a project, @studio/take-render writes audio, @studio/audio-passes runs the offline chains. Consumed as source.",
  "exports": {
    "./commands": "./src/commands.ts",
    "./commandSpec": "./src/commandSpec.ts",
    "./share-bundle": "./src/shareBundle.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/audio-analysis": "*",
    "@studio/audio-passes": "*",
    "@studio/audio-probe": "*",
    "@studio/engine-client": "*",
    "@studio/engine-protocol": "*",
    "@studio/mediatek": "*",
    "@studio/song": "*",
    "@studio/song-edit": "*",
    "@studio/song-schema": "*",
    "@studio/song-video": "*",
    "@studio/take-render": "*",
    "@studio/ui-eyes": "*",
    "@studio/video-prep": "*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@studio/k7x": "*",
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
