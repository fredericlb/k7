{
  "name": "@studio/engine-browser",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The browser's WebSocket link to the C++ engine, and the React store over its ~20 Hz state push. The counterpart of @studio/engine-client (Node) — and the only browser implementation there is, deliberately.",
  "types": "./src/engine.ts",
  "exports": {
    ".": "./src/engine.ts",
    "./access": "./src/access.ts",
    "./store": "./src/engineStore.ts",
    "./params": "./src/params.ts",
    "./probe": "./src/probe.ts",
    "./choose": "./src/choose.ts",
    "./registry": "./src/registry.ts",
    "./lease": "./src/lease.ts",
    "./stream": "./src/streamPlayer.ts",
    "./stream-sink": "./src/streamSink.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@studio/engine-protocol": "*",
    "@studio/web-protocol": "*"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
