{
  "name": "@studio/ui-turntables",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The DJ desk: two turntables meeting at a crossfade, their channel strips, waveforms, cues and set list. Drawn by st0 as a `surfaces/` view. The engine link is a SEAM (./engine) \u2014 a host supplies its own. docs/ holds the desk's rationale and scripts/ the two harnesses that measure a SOUND.",
  "types": "./src/views/MixView.tsx",
  "exports": {
    ".": "./src/views/MixView.tsx",
    "./surface": "./src/views/Turntables.tsx",
    "./engine": "./src/engine.ts",
    "./deck-set": "./src/useDeckSet.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@frediverse/ui": "*",
    "@studio/audio-probe": "*",
    "@studio/engine-browser": "*",
    "@studio/engine-protocol": "*",
    "@studio/graph-model": "*",
    "@studio/mediatek": "*",
    "@studio/project-shell": "*",
    "@studio/song-schema": "*",
    "@studio/ui-chains": "*",
    "@studio/web-protocol": "*",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/ws": "^8.5.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
