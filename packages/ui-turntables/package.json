{
  "name": "@studio/ui-turntables",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The DJ desk: two turntables meeting at a crossfade, their channel strips, waveforms, cues and set list. Drawn by l8 as a `surfaces/` view. The engine link is a SEAM (./engine) — a host supplies its own. docs/ holds the desk's rationale and scripts/ the two harnesses that measure a SOUND.",
  "types": "./src/views/MixView.tsx",
  "exports": {
    ".": "./src/views/MixView.tsx",
    "./surface": "./src/views/Turntables.tsx",
    "./mapping": "./src/mapping.ts",
    "./engine": "./src/engine.ts",
    "./deck-set": "./src/useDeckSet.ts",
    "./deck": "./src/deck.ts",
    "./controls": "./src/controls.ts",
    "./bindings": "./src/mixBindings.ts",
    "./set-list": "./src/setList.ts",
    "./service": "./src/service.ts",
    "./mix-view": "./src/mixView.ts",
    "./graph": "./src/graph.ts",
    "./chains": "./src/chains.tsx",
    "./beats": "./src/beats.ts",
    "./waveform": "./src/waveform.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@frediverse/ui": "*",
    "@studio/engine-browser": "*",
    "@studio/engine-protocol": "*",
    "@studio/graph-model": "*",
    "@studio/mediatek": "*",
    "@studio/project-shell": "*",
    "@studio/song": "*",
    "@studio/ui-chains": "*",
    "@studio/ui-chains-react": "*",
    "@studio/web-protocol": "*",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/ws": "^8.5.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
