{
  "name": "@studio/ui-rehearsal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The rehearsal pages as React — sessions and takes, publications, exercises — mounted by k7 under /rehearsal. The host configures the API base and provides the prefix; the catalogue is its own (messages/, compiled into src/paraglide).",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./addresses": "./src/addresses.ts",
    "./pages": "./src/pages.ts",
    "./public": "./src/public.ts",
    "./settings": "./src/settings.ts",
    "./songAttachment": "./src/components/SongAttachment.tsx"
  },
  "scripts": {
    "i18n": "paraglide-js compile --emit-ts-declarations --output-structure locale-modules --strategy localStorage baseLocale --silent",
    "pretypecheck": "npm run i18n",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run i18n",
    "test": "vitest run"
  },
  "dependencies": {
    "@frediverse/ui": "*",
    "@studio/http-client": "*",
    "@studio/lyrics": "*",
    "@studio/recorder": "*",
    "@studio/score": "*",
    "@studio/rehearsal-shared": "*",
    "@studio/tablature": "*",
    "@studio/engine-browser": "*",
    "@studio/engine-protocol": "*",
    "@studio/mediatek": "*",
    "@studio/web-protocol": "*",
    "@tombatossals/chords-db": "^0.5.1",
    "@tombatossals/react-chords": "^0.2.10",
    "pitchy": "^4.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@frediverse/tsconfig": "*",
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
