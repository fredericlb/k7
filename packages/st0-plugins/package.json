{
  "name": "@studio/st0-plugins",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "st0's builtin plugins and the two composition lists: the server half the file-service installs at boot, and the browser half the shell registers into its pane ring. A plugin is declared with @studio/st0-sdk's definePlugin — see packages/st0-sdk/docs/sdk.md. Consumed as source.",
  "exports": {
    "./server": "./src/server.ts",
    "./browser": "./src/browser.ts",
    "./video": "./src/video/index.ts",
    "./video/camera/relay": "./src/video/camera/relay.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@frediverse/ui": "*",
    "@studio/commands": "*",
    "@studio/engine-browser": "*",
    "@studio/graph-model": "*",
    "@studio/project-shell": "*",
    "@studio/song": "*",
    "@studio/song-schema": "*",
    "@studio/song-video": "*",
    "@studio/st0-sdk": "*",
    "@studio/ui-eyes": "*",
    "@studio/ui-turntables": "*",
    "@studio/web-protocol": "*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
