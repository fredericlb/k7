{
  "name": "@studio/ui-eyes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The studio's eyes — composites a song's video lanes onto its viewport with WebGL, in real time or frame-by-frame to a file. Knows nothing about audio, and nothing about the brain: it takes a plain VideoScene.",
  "exports": {
    "./scene": "./src/scene.ts",
    "./timeline": "./src/timeline.ts",
    "./clock": "./src/clock.ts",
    "./compositor": "./src/compositor.ts",
    "./realtime": "./src/realtime.ts",
    "./export": "./src/export.ts",
    "./exportSupport": "./src/exportSupport.ts",
    "./camera": "./src/camera.ts",
    ".": "./src/index.ts",
    "./exportQuality": "./src/exportQuality.ts",
    "./renderPage": "./src/renderPage.ts",
    "./renderSettings": "./src/renderSettings.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@studio/song-schema": "*",
    "mediabunny": "^1.50.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
