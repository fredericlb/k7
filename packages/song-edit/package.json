{
  "name": "@studio/song-edit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "CHANGING a project rather than compiling one: setting a module's params and assets, moving and resizing events, cutting and consolidating material, splicing time, applying a preset. Every write goes through a YAML writer that changes the value and nothing else — comments, key order and layout all survive. Split out of @studio/song, which now only READS a folder. Consumed as source.",
  "exports": {
    "./projectEdit": "./src/projectEdit.ts",
    "./alternativeSwitch": "./src/alternativeSwitch.ts",
    "./insertTime": "./src/insertTime.ts",
    "./sequenceLoops": "./src/sequenceLoops.ts",
    "./materialCut": "./src/materialCut.ts",
    "./materialWindow": "./src/materialWindow.ts",
    "./trackMix": "./src/trackMix.ts",
    "./windowDescend": "./src/windowDescend.ts",
    "./onsets": "./src/onsets.ts",
    "./presets": "./src/presets.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/song": "*",
    "@studio/song-schema": "*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
