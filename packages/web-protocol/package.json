{
  "name": "@studio/web-protocol",
  "version": "0.2.1",
  "type": "module",
  "files": [
    "*.ts",
    "!*.test.ts",
    "docs"
  ],
  "description": "The shapes the browser and the services agree on \u2014 the engine registry, the workspace and project listings, the quality vocabulary. Types and constants only, no runtime dependency, which is what lets both clients read the same numbers.",
  "types": "./types.ts",
  "exports": {
    ".": "./types.ts",
    "./services": "./services.ts",
    "./projects": "./projects.ts",
    "./tree": "./tree.ts",
    "./quality": "./quality.ts",
    "./rtc-frames": "./rtcFrames.ts",
    "./performance": "./performance.ts",
    "./compat": "./compat.ts",
    "./hunt": "./hunt.ts",
    "./pairing": "./pairing.ts",
    "./settings": "./settings.ts",
    "./handoff": "./handoff.ts",
    "./desktop": "./desktop.ts",
    "./playlists": "./playlists.ts",
    "./paths": "./paths.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@studio/engine-protocol": "^0.2.0"
  }
}
