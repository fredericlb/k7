{
  "name": "@studio/engine-registry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The engine registry: engines announce themselves by heartbeat, browsers list what they can reach. One instance per hosted service, so st0 and pl8 each hold their own — see docs/shared.md.",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./advertise": "./advertise.ts",
    "./proxy": "./proxy.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frediverse/http": "*",
    "@studio/engine-client": "*",
    "@studio/engine-tunnel": "*",
    "@studio/web-protocol": "*",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
