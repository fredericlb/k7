{
  "name": "@studio/mediatek",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The media library: what lives under ~/.lanes/mediatek, how it is scanned, and the change token surfaces poll. A library, not a service — the HTTP routes live in @studio/file-service. Consumed as source.",
  "types": "./src/layout.ts",
  "exports": {
    "./layout": "./src/layout.ts",
    "./types": "./src/types.ts",
    "./scan": "./src/scan.ts",
    "./revision": "./src/revision.ts",
    "./catalogue": "./src/catalogue.ts",
    "./ingest": "./src/ingest.ts",
    "./manifest": "./src/manifest.ts",
    "./remote": "./src/remote.ts",
    "./cache": "./src/cache.ts",
    "./evict": "./src/evict.ts",
    "./write": "./src/write.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "dependencies": {
    "@studio/engine-client": "*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
