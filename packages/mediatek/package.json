{
  "name": "@studio/mediatek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The media library: what lives on its volume, how it is scanned, and the change token surfaces poll. A library, not a service — apps/k7/backend (src/media) serves it and @studio/file-service reads it; both share their vocabulary from here. Consumed as source.",
  "types": "./src/layout.ts",
  "exports": {
    "./layout": "./src/layout.ts",
    "./types": "./src/types.ts",
    "./scan": "./src/scan.ts",
    "./revision": "./src/revision.ts",
    "./catalogue": "./src/catalogue.ts",
    "./media": "./src/media.ts",
    "./song": "./src/song.ts",
    "./recordings": "./src/recordings.ts",
    "./manifest": "./src/manifest.ts",
    "./remote": "./src/remote.ts",
    "./takes": "./src/takes.ts",
    "./write": "./src/write.ts",
    "./playlistItems": "./src/playlistItems.ts",
    "./playlists": "./src/playlists.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "upload-library": "node --experimental-strip-types scripts/uploadLibrary.ts"
  },
  "dependencies": {
    "@studio/web-protocol": "*",
    "@studio/engine-client": "*",
    "yaml": "^2.5.0",
    "@studio/song-schema": "*",
    "@studio/audio-analysis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
