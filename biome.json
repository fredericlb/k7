{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "extends": [
    "./commons/biome.base.json"
  ],
  "files": {
    "includes": [
      "!commons",
      "!**/node_modules",
      "!**/.tmp-*",
      "!**/dist",
      "!**/.turbo",
      "!**/storybook-static",
      "!**/package-lock.json",
      "!**/*.tsbuildinfo",
      "!**/out",
      "!**/*.min.js",
      "!**/*.css",
      "!engine/st0-engine"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "error"
      }
    }
  },
  "javascript": {
    "globals": [
      "Terminal",
      "FitAddon"
    ]
  }
}
