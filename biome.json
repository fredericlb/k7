{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "extends": ["./commons/biome.base.json"],
  "files": {
    "includes": [
      "!commons",
      "!k7-core",
      "!**/node_modules",
      "!**/.tmp-*",
      "!**/dist",
      "!**/storybook-static",
      "!**/package-lock.json",
      "!**/*.tsbuildinfo",
      "!**/out",
      "!**/*.min.js",
      "!**/*.css",
      "!**/*.json",
      "!**/*.jsonc",
      "!engine/k7-runtime",
      "!**/waveformWasm.generated.ts",
      "!**/hostProtocol.generated.ts"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "error"
      }
    }
  },
  "javascript": {
    "globals": ["Terminal", "FitAddon"]
  }
}
