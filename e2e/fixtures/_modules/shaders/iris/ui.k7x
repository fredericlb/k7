// The panel drawn inside this node's card on the graph: the shader picker and the four knobs.
cols(4)
rows(2)
widgets({
  pick: { type: "dropdown", col: 0, row: 0, colSpan: 4, bind: "@shader" },
  p1: { type: "knob", col: 0, row: 1, bind: "P1", min: 0, max: 1, step: 0.01 },
  p2: { type: "knob", col: 1, row: 1, bind: "P2", min: 0, max: 1, step: 0.01 },
  p3: { type: "knob", col: 2, row: 1, bind: "P3", min: 0, max: 1, step: 0.01 },
  p4: { type: "knob", col: 3, row: 1, bind: "P4", min: 0, max: 1, step: 0.01 },
})
