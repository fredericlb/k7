{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k7-tray",
  "version": "../../../package.json",
  "identifier": "org.parapluie.studio.engine-tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "resources": {
      "resources/": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  }
}
