{
  "name": "v1-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "description": "Auth, this service's machine registry and which machine the account cuts on. No file routes and no media: the app reaches the machine's file service directly.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frediverse/http": "*",
    "@frediverse/oidc": "*",
    "@studio/engine-registry": "*",
    "@studio/user-prefs": "*",
    "express": "^4.19.2",
    "tsx": "^4.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
