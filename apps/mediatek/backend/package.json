{
  "name": "mediatek-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The hosted media library: a folder on a volume, served over HTTP. No database — the filesystem is the index, exactly as it is on the machine that caches it.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frediverse/http": "*",
    "@frediverse/oidc": "*",
    "@studio/mediatek": "*",
    "express": "^4.21.2",
    "tsx": "^4.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
