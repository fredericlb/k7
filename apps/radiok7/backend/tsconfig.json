{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Node 22 runs the .ts sources directly via type-stripping, so we never emit
    // — tsc is used only for type-checking, and imports keep their .ts extension.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    // The Grist data layer (store.ts) plumbs dynamic rows; implicit any is
    // tolerated there for now (strict null-checks etc. stay on). Tighten later.
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src"]
}
