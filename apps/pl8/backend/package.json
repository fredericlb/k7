{
  "name": "pl8-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The hosted media library: a folder on a volume, served over HTTP. The filesystem is the index, exactly as it is on the machine that caches it \u2014 the one exception being the comments left on a frozen share, which are concurrent writes and live in SQLite (docs/comments.md).",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run"
  },
  "dependencies": {
    "@frediverse/env": "*",
    "@frediverse/http": "*",
    "@frediverse/oidc": "*",
    "@studio/audio-analysis": "*",
    "@studio/engine-registry": "*",
    "@studio/engine-tunnel": "*",
    "@studio/file-hub": "*",
    "@studio/git-repos": "*",
    "@studio/mediatek": "*",
    "@studio/mpv-player": "*",
    "@studio/song-schema": "*",
    "@studio/user-prefs": "*",
    "@studio/web-protocol": "*",
    "express": "^4.21.2",
    "ssh2-sftp-client": "^12.1.1",
    "tsx": "^4.16.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "vitest": "^4.1.10",
    "typescript": "^7.0.2"
  }
}
