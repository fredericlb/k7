{
  "name": "studio-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "st0 in a window, and the engine that window needs. Electron/TypeScript: it serves st0 from its own local origin and spawns @studio/engine-host as a child over NDJSON on stdio, computing no policy of its own. Closing the window stops the engine.",
  "author": "F <fred@parapluie.org>",
  "homepage": "https://studio.frediver.se",
  "main": "dist/main.cjs",
  "scripts": {
    "app:setup": "node scripts/fetch-electron.mjs",
    "app:build": "node scripts/build-main.mjs",
    "app:watch": "node scripts/build-main.mjs --watch",
    "app:start": "electron dist/main.cjs",
    "build": "node scripts/build-app.mjs",
    "app:spike-job": "node scripts/spike-job.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node scripts/build-main.mjs --watch",
    "engine:build": "node scripts/build-app.mjs",
    "engine:dev": "node scripts/build-main.mjs",
    "engine:start": "node scripts/start-engine.mjs",
    "app:restart": "node scripts/restart-app.mjs",
    "app:stop": "node scripts/restart-app.mjs --stop"
  },
  "dependencies": {
    "@studio/engine-client": "*",
    "@studio/engine-host": "*",
    "@studio/engine-registry": "*",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12"
  },
  "optionalDependencies": {
    "koffi": "^3.1.6",
    "@koromix/koffi-win32-x64": "^3.1.6",
    "@koromix/koffi-win32-arm64": "^3.1.6",
    "@koromix/koffi-linux-x64": "^3.1.6",
    "@koromix/koffi-darwin-arm64": "^3.1.6"
  }
}
