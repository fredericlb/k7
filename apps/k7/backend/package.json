{
  "name": "k7-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "description": "The studio's hosted backend: the origin's OIDC flow, the account's preferences, and the media library — a folder on a volume, served over HTTP, whose filesystem is the index except for the comments on a frozen share, which live in SQLite (docs/media/comments.md).",
  "scripts": {
    "start": "node scripts/with-env.mjs NODE_OPTIONS=--experimental-sqlite tsx src/server.ts",
    "dev": "node scripts/with-env.mjs STUDIO_FILES_WATCH=1 NODE_OPTIONS=--experimental-sqlite tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/with-env.mjs NODE_OPTIONS=--experimental-sqlite vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@frediverse/env": "*",
    "@frediverse/http": "*",
    "@frediverse/oidc": "*",
    "@studio/audio-analysis": "*",
    "@studio/engine-registry": "*",
    "@studio/engine-tunnel": "*",
    "@studio/file-hub": "*",
    "@studio/mediatek": "*",
    "@studio/mpv-player": "*",
    "@studio/rehearsal-server": "*",
    "@studio/song-schema": "*",
    "@studio/ui-module-builder": "*",
    "@studio/user-prefs": "*",
    "@studio/web-protocol": "*",
    "ws": "^8.18.0",
    "express": "^4.21.2",
    "ssh2-sftp-client": "^12.1.1",
    "tsx": "^4.16.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
