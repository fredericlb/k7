{
  "name": "k7-backend",
  "version": "1.0.0",
  "description": "Backend for recording and annotating long music sessions",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "migrate:data": "node --experimental-strip-types src/migratePocketbaseData.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@frediverse/db-grist": "*",
    "@frediverse/env": "*",
    "@frediverse/http": "*",
    "@frediverse/oidc": "*",
    "@k7/shared": "*",
    "@studio/mediatek": "*",
    "@studio/web-protocol": "*",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
