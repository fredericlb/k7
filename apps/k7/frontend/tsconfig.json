{
  "compilerOptions": {
    // ES2022, matching the @studio/* packages this app consumes as RAW SOURCE
    // (vite.config.ts excludes ui-chains/ui-editor/ui-timeline from pre-bundling, so
    // their .ts is compiled here). They're authored at ES2022; checking them under an
    // ES2020 target was a genuine mismatch, not just a style difference.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "notices"]
}
