{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "commons/packages/*",
    "commons/dev/*",
    "packages/*",
    "apps/obscura",
    "apps/radiok7",
    "apps/obscura/backend",
    "apps/obscura/buzzer",
    "apps/obscura/editor",
    "apps/obscura/monitor-web",
    "apps/obscura/online",
    "apps/obscura/presenter",
    "apps/obscura/remote",
    "apps/obscura/shared",
    "apps/radiok7/*",
    "apps/radiok7/packages/*",
    "apps/lanes",
    "apps/lanes/frontend",
    "apps/lanes/backend",
    "apps/mediatek",
    "apps/mediatek/backend",
    "apps/platines",
    "apps/platines/backend",
    "apps/moteur",
    "apps/capot"
  ],
  "scripts": {
    "clean": "rm -rf node_modules .turbo commons/packages/*/node_modules commons/dev/*/node_modules packages/*/node_modules apps/*/node_modules apps/*/*/node_modules apps/*/*/*/node_modules",
    "caddy": "node commons/scripts/caddy.mjs",
    "commons:sync": "git submodule update --remote --merge commons",
    "build": "turbo run build",
    "test": "turbo run test",
    "images": "bash commons/scripts/build-images.sh",
    "check-images": "node commons/scripts/check-image-closure.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@chromatic-com/storybook": "^5.2.1",
    "@inlang/paraglide-js": "^2.22.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "turbo": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10",
      "onFail": "ignore"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
