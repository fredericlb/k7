{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "commons/packages/*",
    "commons/dev/*",
    "packages/*",
    "apps/k7",
    "apps/k7/frontend",
    "apps/k7/backend",
    "apps/k7-tray",
    "engine/k7-runtime",
    "engine/k7-android/web",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:tray": "node scripts/dev-tray.mjs",
    "clean": "rm -rf node_modules commons/packages/*/node_modules commons/dev/*/node_modules packages/*/node_modules apps/*/node_modules apps/*/*/node_modules apps/*/*/*/node_modules",
    "tokens": "node scripts/tokens.mjs",
    "commons:sync": "git submodule update --remote --merge commons",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/workspaces.mjs test",
    "test:console": "node --test \"scripts/console/*.test.mjs\"",
    "typecheck": "node scripts/workspaces.mjs typecheck",
    "check:changed": "node scripts/agent/check-changed.mjs",
    "images": "bash commons/scripts/build-images.sh",
    "check-images": "node commons/scripts/check-image-closure.cjs",
    "vscode": "node scripts/vscode.mjs",
    "console": "npm install --prefix scripts/console --no-audit --no-fund && node scripts/console/server.mjs",
    "remote:install": "node scripts/remote.mjs install",
    "remote:uninstall": "node scripts/remote.mjs uninstall",
    "remote:status": "node scripts/remote.mjs status",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:bytes": "node scripts/check-source-bytes.mjs",
    "lint:docs": "node scripts/check-doc-links.mjs",
    "lint:comments": "node scripts/check-comments.mjs",
    "lint:version": "node scripts/check-version.mjs",
    "lint:dead": "knip",
    "lint:panels": "tsx packages/song/scripts/checkPanelBinds.ts",
    "lint:layouts": "tsx packages/ui-module-builder/scripts/checkLayouts.ts",
    "engine:build": "node engine/scripts/build-engine.mjs",
    "test:e2e": "npm run e2e --workspace @studio/e2e --",
    "test:e2e:android": "npm run e2e:android --workspace @studio/e2e --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@chromatic-com/storybook": "^5.2.1",
    "@inlang/paraglide-js": "^2.22.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "^10.5.0",
    "@studio/supervisor-host": "*",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.0.1",
    "knip": "6.32.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.2",
    "yaml": "^2.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10",
      "onFail": "ignore"
    }
  },
  "overrides": {
    "@tombatossals/react-chords": {
      "react": "^19.2.7",
      "react-dom": "^19.2.7"
    },
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
