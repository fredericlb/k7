{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "commons/packages/*",
    "commons/dev/*",
    "packages/*",
    "apps/z0",
    "apps/k7",
    "apps/z0/backend",
    "apps/z0/buzzer",
    "apps/z0/editor",
    "apps/z0/editor-v2",
    "apps/z0/monitor-web",
    "apps/z0/online",
    "apps/z0/presenter",
    "apps/z0/remote",
    "apps/z0/shared",
    "apps/k7/*",
    "apps/k7/packages/*",
    "apps/l8",
    "apps/l8/frontend",
    "apps/l8/backend",
    "apps/st0",
    "apps/st0/frontend",
    "apps/st0/backend",
    "engine/moteur",
    "engine/capot"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:native": "node scripts/dev-native.mjs",
    "clean": "rm -rf node_modules .turbo commons/packages/*/node_modules commons/dev/*/node_modules packages/*/node_modules apps/*/node_modules apps/*/*/node_modules apps/*/*/*/node_modules",
    "tokens": "node scripts/tokens.mjs",
    "commons:sync": "git submodule update --remote --merge commons",
    "build": "turbo run build",
    "test": "turbo run test",
    "images": "bash commons/scripts/build-images.sh",
    "check-images": "node commons/scripts/check-image-closure.cjs",
    "vscode": "node scripts/vscode.mjs",
    "console": "node scripts/console/server.mjs",
    "remote:install": "node scripts/remote.mjs install",
    "remote:uninstall": "node scripts/remote.mjs uninstall",
    "remote:status": "node scripts/remote.mjs status",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@chromatic-com/storybook": "^5.2.1",
    "@inlang/paraglide-js": "^2.22.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "turbo": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10",
      "onFail": "ignore"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  }
}
